theorem shake_128s_checked : run shake_128s_image = some (expected Spec.shake_128s) := by decide +kernel
def shake_128s_trace {msg sig pk events} (h : run shake_128s_image = some events)
    (v : Callees Spec.shake_128s msg sig pk) := trace h shake_128s_checked (by decide) v
theorem shake_128s_eq {msg sig pk events} (h : run shake_128s_image = some events)
    (v : Callees Spec.shake_128s msg sig pk) : returned v events = Spec.slhVerifyInternal Spec.shake_128s msg sig pk :=
  (shake_128s_trace h v).eq_spec
