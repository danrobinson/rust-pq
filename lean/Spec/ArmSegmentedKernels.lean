structure Literals where
  iv : List Nat
  k : List Nat
  padding : List Nat

def pinned (f : ArmSegmentedFrame.Image) (c : Literals) : Bool := Id.run do
  let (entry,ipad,outer) ← match f.p.n with
    | 16 => pure (0x10006de8c,ipad16,outer16)
    | 24 => pure (0x10006e620,ipad24,outer24)
    | 32 => pure (0x10006ee50,ipad32,outer32)
    | _ => return false
  let narrow := f.p.n == 16
  let h := if narrow then SHA256.H0.map BitVec.toNat else SHA512.H0.map BitVec.toNat
  let iv := if narrow then h.drop 4 ++ h.take 4 else
    h.drop 6 ++ (h.drop 4).take 2 ++ (h.drop 2).take 2 ++ h.take 2
  let roundConstants := if narrow then SHA256.K.map BitVec.toNat else SHA512.K.map BitVec.toNat
  let padding := if narrow then [2^31,0,0,0,0,0,0,768] else [2^63,0,0,1536]
  return f.entry == entry && f.words.extract (f.copyEnd+1) f.innerStart == ipad &&
    f.words.extract (f.innerEnd+1) f.digestStart == outer && c.iv == iv && c.k == roundConstants && c.padding == padding

end Spec.ArmSegmentedSigner
