/-! The six parameter sets: the functions of the per-set modules of `sets.rs`
(fixed-size key types), each from the generic proof at its `Params` value.
Generated by a script (one block per set, the same text with the set's
sizes); every proof below is checked by Lean. -/

namespace slhdsa

theorem from_slice_eq {n : Usize} (a : Array U8 n) (s : Slice U8) (h : s.length = n.val) :
    (Array.from_slice a s).val = s.val := Array.from_slice_val _ _ (by simpa using h)


/-! ## SLH-DSA-SHA2-128s -/

namespace sha2_128s

theorem PARAMS_eq : sets.sha2_128s.params.PARAMS = params.SHA2_128S := by
  unfold sets.sha2_128s.params.PARAMS; rfl

theorem hP : paramsS sets.sha2_128s.params.PARAMS = Spec.sha2_128s := by
  rw [PARAMS_eq]; exact paramsS_128s

theorem pn : PN sets.sha2_128s.params.PARAMS 16#usize :=
  ⟨by rw [hP]; exact Spec.sha2_128s_valid, by rw [PARAMS_eq]; unfold params.SHA2_128S; rfl⟩

theorem slack : msgSlack (16#usize : Usize).val = 152 := by simp [msgSlack]

@[step]
theorem slh_keygen_internal_spec (sk_seed sk_prf pk_seed : Array U8 16#usize) :
    sets.sha2_128s.slh_keygen_internal sk_seed sk_prf pk_seed ⦃ r =>
      (bytes r.1.val, bytes r.2.val) =
        Spec.slhKeygenInternal Spec.sha2_128s (bytes sk_seed.val) (bytes sk_prf.val) (bytes pk_seed.val) ⦄ := by
  unfold sets.sha2_128s.slh_keygen_internal
  let* ⟨ s, back, s_post, back_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ s1, back1, s1_post, back1_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ s2, s3, h1, h2, h3 ⟩ ← slhdsa.slh_keygen_internal_spec _ pn sk_seed sk_prf pk_seed s s1
    (by simp [Slice.length, s_post]) (by simp [Slice.length, s1_post])
  rw [back_post, back1_post, from_slice_eq _ _ (by rw [h2]; rfl), from_slice_eq _ _ (by rw [h3]; rfl),
    ← hP]
  exact h1

@[step]
theorem slh_sign_internal_spec (m : Slice U8) (sk : Array U8 64#usize) (addrnd : Array U8 16#usize)
    (hm : Room m.length 152) :
    sets.sha2_128s.slh_sign_internal m sk addrnd ⦃ sig =>
      bytes sig.val = Spec.slhSignInternal Spec.sha2_128s (bytes m.val) (bytes sk.val) (bytes addrnd.val) ⦄ := by
  unfold sets.sha2_128s.slh_sign_internal
  let* ⟨ s, s_post ⟩ ← Array.to_slice.step_spec
  apply WP.spec_mono (slhdsa.slh_sign_internal_spec _ pn m s addrnd (by simp [s_post]) (by rw [slack]; exact hm))
  rintro r ⟨h1, -⟩
  rw [h1, s_post, Array.val_to_slice, hP]

