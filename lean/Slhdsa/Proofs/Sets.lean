@[step]
theorem secret_key_from_spec (b : Slice U8) :
    sets.sha2_256f.secret_key_from b ⦃ r =>
      r.map (·.val) = if b.length = 128 then some b.val else none ⦄ := by
  unfold sets.sha2_256f.secret_key_from
  let* ⟨ s, back, s_post, back_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ bk, s1, h1, h2, h3 ⟩ ← enc_secret_key_from_spec
  have hs : s.length = 128 := by simp [Slice.length, s_post]
  split
  · rename_i hok
    have hb : b.length = 128 := by simpa [hs] using h1.symm.trans hok
    simp [hb, back_post, from_slice_eq _ _ (show s1.length = (128#usize : Usize).val by
      simp [Slice.length, h2 hok, hb]), h2 hok]
  · rename_i hok
    have hb : ¬ b.length = 128 := by simpa [hs, hok] using h1.symm
    simp [hb]

