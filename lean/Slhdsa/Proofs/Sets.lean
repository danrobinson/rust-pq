  split
  · rename_i hok
    have hb : b.length = 64 := by simpa [hs] using h1.symm.trans hok
    simp [hb, back_post, from_slice_eq _ _ (show s1.length = (64#usize : Usize).val by
      simp [Slice.length, h2 hok, hb]), h2 hok]
  · rename_i hok
    have hb : ¬ b.length = 64 := by simpa [hs, hok] using h1.symm
    simp [hb]

