    simp [hb, back_post, from_slice_eq _ _ (show s1.length = (64#usize : Usize).val by
      simp [Slice.length, h2 hok, hb]), h2 hok]
  · rename_i hok
    have hb : ¬ b.length = 64 := by simpa [hs, hok] using h1.symm
    simp [hb]

theorem signature_len_ok_eq (b : Slice U8) :
    sets.sha2_256f.signature_len_ok b = ok (decide (b.length = 49856)) := by
  unfold sets.sha2_256f.signature_len_ok
  obtain ⟨r, h, hr⟩ := spec_imp_exists (enc_signature_len_ok_spec _ pn.valid b)
  rw [h, hr, hP]
  rfl

@[step]
theorem secret_keys_equal_spec (a b : Array U8 128#usize) :
    sets.sha2_256f.secret_keys_equal a b ⦃ r => r = decide (a = b) ⦄ := by
  unfold sets.sha2_256f.secret_keys_equal
  let* ⟨ s, s_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s1, s1_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ r, r_post ⟩ ← enc_secret_keys_equal_spec s s1 (by simp [s_post, s1_post])
  rw [r_post, s_post, s1_post, Array.val_to_slice, Array.val_to_slice]
  by_cases h : a = b
  · simp [h]
  · have : a.val ≠ b.val := fun e => h (Aeneas.Std.Array.ext _ _ e)
    simp [h, this]

@[step]
theorem pkcs8_encode_spec (sk : Array U8 128#usize) (out : Array U8 150#usize) :
    sets.sha2_256f.pkcs8_encode sk out ⦃ r => r.val = sets.sha2_256f.PKCS8_PREFIX.val ++ sk.val ⦄ := by
  unfold sets.sha2_256f.pkcs8_encode
  let* ⟨ s, s_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s1, s1_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s2, back, s2_post, back_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ s3, s3_post ⟩ ← enc_der_encode_spec s s1 s2 (by simp [Slice.length, s_post, s1_post, s2_post])
  rw [back_post, from_slice_eq _ _ (by simp [Slice.length, s3_post, s_post, s1_post]), s3_post, s_post, s1_post,
    Array.val_to_slice, Array.val_to_slice]

@[step]
theorem pkcs8_decode_spec (der : Slice U8) (sk : Array U8 128#usize) :
    sets.sha2_256f.pkcs8_decode der sk ⦃ r =>
      (r.1 = true → der.val = sets.sha2_256f.PKCS8_PREFIX.val ++ r.2.val) ∧
      (r.1 = false → r.2 = sk ∧
        ∀ key : Array U8 128#usize, der.val ≠ sets.sha2_256f.PKCS8_PREFIX.val ++ key.val) ⦄ := by
  unfold sets.sha2_256f.pkcs8_decode
  let* ⟨ s, s_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s1, back, s1_post, back_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ bk, s2, h1, h2 ⟩ ← enc_der_decode_spec s der s1 (by simp [Slice.length, s_post, s1_post]; scalar_tac)
  have hs1 : s1.length = 128 := by simp [Slice.length, s1_post]
  refine ⟨fun hok => ?_, fun hok => ?_⟩
  · obtain ⟨e, hl⟩ := h1 hok
    rw [back_post, from_slice_eq _ _ (by rw [hl, hs1]; rfl), e, s_post, Array.val_to_slice]
  · obtain ⟨e, hne⟩ := h2 hok
    refine ⟨?_, fun key hk => hne key.val (by simp [hs1]) (by rw [s_post, Array.val_to_slice]; exact hk)⟩
    rw [back_post, e]
    apply Aeneas.Std.Array.ext
    rw [from_slice_eq _ _ (by rw [hs1]; rfl), s1_post]

@[step]
theorem spki_encode_spec (pk : Array U8 64#usize) :
    sets.sha2_256f.spki_encode pk ⦃ r => r.val = sets.sha2_256f.SPKI_PREFIX.val ++ pk.val ⦄ := by
  unfold sets.sha2_256f.spki_encode
  let* ⟨ s, s_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s1, s1_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s2, back, s2_post, back_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ s3, s3_post ⟩ ← enc_der_encode_spec s s1 s2 (by simp [Slice.length, s_post, s1_post, s2_post])
  rw [back_post, from_slice_eq _ _ (by simp [Slice.length, s3_post, s_post, s1_post]), s3_post, s_post, s1_post,
    Array.val_to_slice, Array.val_to_slice]

@[step]
theorem spki_decode_spec (der : Slice U8) :
    sets.sha2_256f.spki_decode der ⦃ r =>
      (∀ key, r = some key → der.val = sets.sha2_256f.SPKI_PREFIX.val ++ key.val) ∧
      (r = none → ∀ key : Array U8 64#usize, der.val ≠ sets.sha2_256f.SPKI_PREFIX.val ++ key.val) ⦄ := by
  unfold sets.sha2_256f.spki_decode
  let* ⟨ s, s_post ⟩ ← Array.to_slice.step_spec
  let* ⟨ s1, back, s1_post, back_post ⟩ ← Array.to_slice_mut_spec
  let* ⟨ bk, s2, h1, h2 ⟩ ← enc_der_decode_spec s der s1 (by simp [Slice.length, s_post, s1_post]; scalar_tac)
  have hs1 : s1.length = 64 := by simp [Slice.length, s1_post]
  split
  · rename_i hok
    simp only [WP.spec_ok]
    obtain ⟨e, hl⟩ := h1 hok
    refine ⟨fun key hk => ?_, fun h => by simp at h⟩
    simp only [Option.some.injEq] at hk
    subst hk
    rw [back_post, from_slice_eq _ _ (by rw [hl, hs1]; rfl), e, s_post, Array.val_to_slice]
  · rename_i hok
    have hok' : bk = false := by simpa using hok
    simp only [WP.spec_ok]
    obtain ⟨-, hne⟩ := h2 hok'
    refine ⟨fun key hk => by simp at hk, fun _ key hk => hne key.val (by simp [hs1]) ?_⟩
    rw [s_post, Array.val_to_slice]; exact hk

end sha2_256f

