import Ct.Funs
import Slhdsa.Funs
import Ct.Arith

/-!
# Erasure: the instrumented program is the verified program

For every definition `slhdsa.f` of `Slhdsa/Funs.lean` this file proves (by a uniform tactic,
generated by the command `#ct_derive_erasure`, in dependency order)

* `slhdsa_leak.f.erase_eq : ∀ args, Ct.Leak.erase (slhdsa_leak.f args) = slhdsa.f args` when
  `f` returns a `Result`,
* `slhdsa_leak.f.erase_eq : slhdsa_leak.f = slhdsa.f` for constants,
* `slhdsa_leak.f.erase_eq : (slhdsa_leak.f).erase = slhdsa.f` for the `Clone`/`Copy`
  dictionaries.

All of them are tagged `ct_erase`, so they compose.
-/

open Lean Meta Elab Command Term
open Aeneas Aeneas.Std Ct

namespace Ct.Erase

/-- `bind` congruence that may use the fact that the first computation returned. -/
theorem bind_congr_ok {α : Type u} {β : Type v} {m : Result α} {f g : α → Result β}
    (h : ∀ a, m = .ok a → f a = g a) : Aeneas.Std.bind m f = Aeneas.Std.bind m g := by
  rcases Result.cases_flat m with ⟨a, rfl⟩ | ⟨e, rfl⟩ | rfl
  · simp [h a rfl]
  · simp
  · simp

attribute [ct_erase] Aeneas.Std.lift

@[ct_erase] theorem erase_hDiv {ty : UScalarTy} (x y : UScalar ty) :
    (@HDiv.hDiv _ _ _ slhdsa_leak.instHDivUScalarLeak x y).erase =
      @HDiv.hDiv _ _ _ Aeneas.Std.instHDivUScalarResult x y :=
  Leak.erase_prim _ _

@[ct_erase] theorem erase_hMod {ty : UScalarTy} (x y : UScalar ty) :
    (@HMod.hMod _ _ _ slhdsa_leak.instHModUScalarLeak x y).erase =
      @HMod.hMod _ _ _ Aeneas.Std.instHModUScalarResult x y :=
  Leak.erase_prim _ _
attribute [ct_erase] slhdsa_leak.core.clone.Clone.erase slhdsa_leak.core.marker.Copy.erase

/-- The uniform erasure tactic: unfold both definitions, push `erase` inwards, and use the
erasure theorems of the callees. -/
syntax "ct_erase_tac" ident ident : tactic
macro_rules
  | `(tactic| ct_erase_tac $l $o) => `(tactic| (
      intros
      simp only [$l:term, $o:term, ct_erase]
      try rfl))

/-- Erasure of the two recursive functions (`fors_node`, `xmss_node`, recursion on the height `z`,
which decreases by the checked `z - 1`): strong induction on `z.val`. -/
syntax "ct_erase_rec_tac" ident ident : tactic
macro_rules
  | `(tactic| ct_erase_rec_tac $l $o) => `(tactic| (
      intro sk i z
      induction hz : z.val using Nat.strong_induction_on generalizing i z with
      | _ n ih =>
        intro seed adrs
        rw [$l:ident, $o:ident]
        simp only [ct_erase]
        split_ifs
        · rfl
        · refine bind_congr_ok fun i1 _ => bind_congr_ok fun i2 h2 => ?_
          have h2' := Ct.Arith.sub_ok h2
          simp only [ih i2.val (by simp at h2'; omega) _ i2 rfl]))

/-- The definitions of `Slhdsa.Funs` (except the `partial_fixpoint` auxiliaries), in
dependency order. -/
def funsDecls : MetaM (Array Name) := do
  let env ← getEnv
  let some idx := env.getModuleIdx? `Slhdsa.Funs | throwError "Slhdsa.Funs not imported"
  let names := env.header.moduleData[idx.toNat]!.constNames
  let mut ds : Array Name := #[]
  for n in names do
    let some (.defnInfo _) := env.find? n | continue
    if n.isInternalDetail then continue
    if ← isMatcher n then continue
    if n.components.getLast! == `mutual then continue
    ds := ds.push n
  let set : NameSet := ds.foldl (·.insert ·) {}
  -- dependencies (through the `.mutual` auxiliary of a `partial_fixpoint`)
  let deps (n : Name) : Array Name := Id.run do
    let some (.defnInfo dv) := env.find? n | return #[]
    let mut out := #[]
    for c in dv.value.getUsedConstants do
      if set.contains c && c != n then out := out.push c
      if c.components.getLast! == `mutual then
        if let some (.defnInfo mv) := env.find? c then
          for c' in mv.value.getUsedConstants do
            if set.contains c' && c' != n then out := out.push c'
    return out
  -- topological sort (stable w.r.t. name order)
  let sorted := ds.qsort (fun a b => a.toString < b.toString)
  let mut done : NameSet := {}
  let mut order : Array Name := #[]
  let mut progress := true
  while progress do
    progress := false
    for n in sorted do
      if done.contains n then continue
      if (deps n).all done.contains then
        done := done.insert n; order := order.push n; progress := true
  if order.size != ds.size then throwError "funsDecls: cyclic dependencies"
  return order

/-- The leak counterpart of `slhdsa.f`. -/
def leakName (n : Name) : Name := n.replacePrefix `slhdsa `slhdsa_leak

/-- Build the erasure statement for `n`. -/
def statement (n : Name) : MetaM Expr := do
  let info ← getConstInfo n
  let lvls := info.levelParams.map Level.param
  let ln := leakName n
  forallTelescope info.type fun xs body => do
    let o := mkAppN (mkConst n lvls) xs
    let l := mkAppN (mkConst ln lvls) xs
    let body ← whnfR body
    let eq ← match body.getAppFn.constName? with
      | some ``Aeneas.Std.Result => mkEq (← mkAppM ``Ct.Leak.erase #[l]) o
      | some ``Aeneas.Std.core.clone.Clone => mkEq (← mkAppM ``slhdsa_leak.core.clone.Clone.erase #[l]) o
      | some ``Aeneas.Std.core.marker.Copy => mkEq (← mkAppM ``slhdsa_leak.core.marker.Copy.erase #[l]) o
      | _ => mkEq l o
    mkForallFVars xs eq

/-- Prove and add the erasure theorem of `n`, with the given tactic. -/
def deriveOne (n : Name) (tac : Syntax) : TermElabM Unit := do
  let stmt ← statement n
  let thmName := leakName n ++ `erase_eq
  let mvar ← mkFreshExprMVar stmt
  Term.runTactic mvar.mvarId! tac .term
  let pf ← instantiateMVars mvar
  if pf.hasMVar || pf.hasSyntheticSorry || pf.hasSorry then
    throwError "erasure of {n}: proof incomplete"
  let lps := (← getConstInfo n).levelParams
  addDecl <| Declaration.thmDecl
    { «name» := thmName, levelParams := lps, type := stmt, value := pf }
  -- tag it `ct_erase`
  let some ext ← getSimpExtension? `ct_erase | throwError "no ct_erase"
  addSimpTheorem ext thmName (post := true) (inv := false) .global (eval_prio default)

/-- Recursive (`partial_fixpoint`) definitions get a dedicated proof. -/
def isRecursive (n : Name) : MetaM Bool := do
  return (← getEnv).contains (n ++ `mutual)

/-- Derive the erasure theorems of all definitions of `Slhdsa.Funs` up to (excluding) the
first one in `stop`. Reports every failure. -/
elab "#ct_derive_erasure" : command => do
  let order ← liftTermElabM funsDecls
  let mut failed : Array Name := #[]
  let mut nOk : Nat := 0
  for n in order do
    let l := mkIdent (leakName n)
    let o := mkIdent n
    let tac ← if ← liftTermElabM (isRecursive n) then
        `(term| by ct_erase_rec_tac $l $o)
      else `(term| by ct_erase_tac $l $o)
    try
      liftTermElabM do
        withoutErrToSorry (deriveOne n tac)
      nOk := nOk + 1
    catch e =>
      failed := failed.push n
      logError m!"erasure of {n} failed: {e.toMessageData}"
  logInfo m!"ct_derive_erasure: {nOk} erasure theorems, {failed.size} failures"

end Ct.Erase

#ct_derive_erasure
