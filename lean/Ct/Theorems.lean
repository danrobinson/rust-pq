import Ct.Sign
import Slhdsa.Theorems

/-!
# Constant time: the headline theorems, generic part

The leakage model is `Ct/Model.lean` with `Ct/ModelBuild.lean` (which primitive emits which
event); the instrumented program is `Ct/Funs.lean` (the verified program's text), and
`Ct/Erase.lean` proves that it computes exactly the verified functions. A run returning
`(r, t)` returns `r` with trace `t`.

This file has the statements that do not depend on the parameter set: SHA-256 and SHA-512
(`sha256_trace_eq`, `sha512_trace_eq`), and the generic statements of key generation, for any
`p` with `PN p N`. The generic signing theorems are `Ct.Sign.sign_internal`, … (simulator
`slhdsa_leak.Sim.*` at `N` and `p`). The per-set headline statements, the counterparts of the
single-set tree's `lean/Ct/Theorems.lean`, are in `Ct/Sets/*.lean`, generated by
`scripts/gen/ct_thms.py`.
-/

open Aeneas Aeneas.Std Ct

namespace Ct.Theorems

/-! ## SHA-256 and SHA-512 are constant time

The instrumented hash on any two messages of the same length (within the size limit of the
functional theorem) returns the digests computed by the verified function, with the same
trace. -/

theorem sha256_trace_eq (msg msg' : Slice U8) (h : msg.length = msg'.length)
    (hr : slhdsa.Room msg.length 72) :
    ∃ d d' t, slhdsa.sha256.sha256 msg = .ok d ∧ slhdsa.sha256.sha256 msg' = .ok d' ∧
      (slhdsa_leak.sha256.sha256 msg).run = .ok (d, t) ∧
      (slhdsa_leak.sha256.sha256 msg').run = .ok (d', t) := by
  obtain ⟨d, hd, -⟩ := slhdsa.sha256_correct msg hr
  obtain ⟨d', hd', -⟩ := slhdsa.sha256_correct msg' (h ▸ hr)
  obtain ⟨t, h1, h2, -⟩ := (Ct.Sha256.sha256 msg msg' h).same_trace
    ((slhdsa_leak.sha256.sha256.erase_eq msg).trans hd)
    ((slhdsa_leak.sha256.sha256.erase_eq msg').trans hd')
  exact ⟨d, d', t, hd, hd', h1, h2⟩

theorem sha512_trace_eq (msg msg' : Slice U8) (h : msg.length = msg'.length)
    (hr : msg.length + 144 ≤ Usize.max) :
    ∃ d d' t, slhdsa.sha512.sha512 msg = .ok d ∧ slhdsa.sha512.sha512 msg' = .ok d' ∧
      (slhdsa_leak.sha512.sha512 msg).run = .ok (d, t) ∧
      (slhdsa_leak.sha512.sha512 msg').run = .ok (d', t) := by
  obtain ⟨d, hd, -⟩ := slhdsa.sha512_correct msg hr
  obtain ⟨d', hd', -⟩ := slhdsa.sha512_correct msg' (h ▸ hr)
  obtain ⟨t, h1, h2, -⟩ := (Ct.Sha512.sha512 msg msg' h).same_trace
    ((slhdsa_leak.sha512.sha512.erase_eq msg).trans hd)
    ((slhdsa_leak.sha512.sha512.erase_eq msg').trans hd')
  exact ⟨d, d', t, hd, hd', h1, h2⟩

/-! ## Key generation, generic -/

namespace generic

/-- Any two runs of the generic `slh_keygen_internal` that return have the same trace, with no
hypothesis relating the seeds; the output buffers may differ except in length. -/
theorem keygen_internal_ct {N : Usize} (p : slhdsa.params.Params)
    (sk_seed sk_prf pk_seed sk_seed' sk_prf' pk_seed' : Std.Array U8 N) (sk pk sk' pk' : Slice U8)
    (hsk : sk.length = sk'.length) (hpk : pk.length = pk'.length) :
    Rel (slhdsa_leak.slh.slh_keygen_internal p sk_seed sk_prf pk_seed sk pk)
      (slhdsa_leak.slh.slh_keygen_internal p sk_seed' sk_prf' pk_seed' sk' pk') (fun _ _ => True) :=
  (Ct.Slh.slh_keygen_internal p _ _ _ _ _ _ _ _ _ _ hsk hpk).mono fun _ _ _ => trivial

theorem keygen_internal_trace {N : Usize} (p : slhdsa.params.Params) (hp : slhdsa.PN p N)
    (sk_seed sk_prf pk_seed sk_seed' sk_prf' pk_seed' : Std.Array U8 N) (sk pk sk' pk' : Slice U8)
    (hsk : sk.length = 4 * N.val) (hpk : pk.length = 2 * N.val)
    (hsk' : sk'.length = 4 * N.val) (hpk' : pk'.length = 2 * N.val) :
    ∃ r r' t, slhdsa.slh.slh_keygen_internal p sk_seed sk_prf pk_seed sk pk = .ok r ∧
      slhdsa.slh.slh_keygen_internal p sk_seed' sk_prf' pk_seed' sk' pk' = .ok r' ∧
      (slhdsa_leak.slh.slh_keygen_internal p sk_seed sk_prf pk_seed sk pk).run = .ok (r, t) ∧
      (slhdsa_leak.slh.slh_keygen_internal p sk_seed' sk_prf' pk_seed' sk' pk').run = .ok (r', t) := by
  obtain ⟨r, h, -⟩ := slhdsa.spec_imp_exists
    (slhdsa.slh_keygen_internal_spec p hp sk_seed sk_prf pk_seed sk pk hsk hpk)
  obtain ⟨r', h', -⟩ := slhdsa.spec_imp_exists
    (slhdsa.slh_keygen_internal_spec p hp sk_seed' sk_prf' pk_seed' sk' pk' hsk' hpk')
  obtain ⟨t, h1, h2, -⟩ := (keygen_internal_ct p sk_seed sk_prf pk_seed sk_seed' sk_prf' pk_seed'
      sk pk sk' pk' (by omega) (by omega)).same_trace
    ((slhdsa_leak.slh.slh_keygen_internal.erase_eq _ _ _ _ _ _).trans h)
    ((slhdsa_leak.slh.slh_keygen_internal.erase_eq _ _ _ _ _ _).trans h')
  exact ⟨_, _, t, h, h', h1, h2⟩

theorem keygen_ct (N : Usize) (p : slhdsa.params.Params) (seeds seeds' sk sk' pk pk' : Slice U8)
    (h1 : seeds.length = seeds'.length) (h2 : sk.length = sk'.length)
    (h3 : pk.length = pk'.length) :
    Rel (slhdsa_leak.api.keygen N p seeds sk pk) (slhdsa_leak.api.keygen N p seeds' sk' pk')
      (fun _ _ => True) :=
  (Ct.Slh.keygen N p _ _ _ _ _ _ h1 h2 h3).mono fun _ _ _ => trivial

end generic

end Ct.Theorems

