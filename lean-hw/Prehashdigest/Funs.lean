  | none => ok false
  | some p1 =>
    let (mp, len) := p1
    match family with
    | cache.HashFamily.Sha2 =>
      let s ←
        core.array.Array.index (core.ops.index.IndexSlice
          (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) mp
          { «end» := len }
      slh.slh_verify_internal N p s sig pk
    | cache.HashFamily.Shake =>
      let s ←
        core.array.Array.index (core.ops.index.IndexSlice
          (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) mp
          { «end» := len }
      shake.slh.slh_verify_internal N p s sig pk

