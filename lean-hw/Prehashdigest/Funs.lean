def prehash.shake128_loop2.body
  (output : Slice Std.U8) (lanes : Array Std.U64 25#usize)
  (out_pos : Std.Usize) (out_i : Std.Usize) :
  Result (ControlFlow ((Slice Std.U8) × (Array Std.U64 25#usize) × Std.Usize
    × Std.Usize) (Slice Std.U8))
  := do
  let i := Slice.len output
  if out_i < i
  then
    let (lanes1, out_pos1) ←
      if out_pos = prehash.RATE_SHAKE128
      then do
           let lanes2 ← prehash.keccak_f1600 lanes
           ok (lanes2, 0#usize)
      else ok (lanes, out_pos)
    let i1 ← out_pos1 / 8#usize
    let i2 ← Array.index_usize lanes1 i1
    let i3 ← out_pos1 % 8#usize
    let i4 ← 8#usize * i3
    let i5 ← i2 >>> i4
    let i6 ← lift (UScalar.cast .U8 i5)
    let s ← Slice.update output out_i i6
    let out_pos2 ← out_pos1 + 1#usize
    let out_i1 ← out_i + 1#usize
    ok (cont (s, lanes1, out_pos2, out_i1))
  else ok (done output)

