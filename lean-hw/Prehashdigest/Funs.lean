@[rust_loop_body]
def prehash.shake128_loop1.body
  (input : Slice Std.U8) (lanes : Array Std.U64 25#usize) (pos : Std.Usize)
  (i : Std.Usize) :
  Result (ControlFlow ((Array Std.U64 25#usize) × Std.Usize × Std.Usize)
    ((Array Std.U64 25#usize) × Std.Usize))
  := do
  let i1 := Slice.len input
  if i < i1
  then
    let i2 ← Slice.index_usize input i
    let i3 ← lift (UScalar.cast .U64 i2)
    let i4 ← pos % 8#usize
    let i5 ← 8#usize * i4
    let i6 ← i3 <<< i5
    let i7 ← pos / 8#usize
    let i8 ← Array.index_usize lanes i7
    let i9 ← lift (i8 ^^^ i6)
    let (_, index_mut_back) ← Array.index_mut_usize lanes i7
    let pos1 ← pos + 1#usize
    let (lanes1, pos2) ←
      if pos1 = prehash.RATE_SHAKE128
      then
        do
        let lanes2 := index_mut_back i9
        let lanes3 ← prehash.keccak_f1600 lanes2
        ok (lanes3, 0#usize)
      else let a := index_mut_back i9
           ok (a, pos1)
    let i10 ← i + 1#usize
    ok (cont (lanes1, pos2, i10))
  else ok (done (lanes, pos))

