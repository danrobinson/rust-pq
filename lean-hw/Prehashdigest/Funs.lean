/-- [slhdsa::prehash::shake128]:
    Source: 'src/prehash.rs', lines 180:0-232:1
    Visibility: public -/
def prehash.shake128
  (input : Slice Std.U8) (output : Slice Std.U8) : Result (Slice Std.U8) := do
  let lanes := Array.repeat 25#usize 0#u64
  let (lanes1, pos, i) ← prehash.shake128_loop0 input lanes 0#usize 0#usize
  let (lanes2, pos1) ← prehash.shake128_loop1 input lanes1 pos i
  let i1 ← pos1 % 8#usize
  let i2 ← 8#usize * i1
  let i3 ← 31#u64 <<< i2
  let i4 ← pos1 / 8#usize
  let i5 ← Array.index_usize lanes2 i4
  let i6 ← lift (i5 ^^^ i3)
  let lanes3 ← Array.update lanes2 i4 i6
  let i7 ← 1#u64 <<< 63#i32
  let i8 ← prehash.RATE_SHAKE128 / 8#usize
  let i9 ← i8 - 1#usize
  let i10 ← Array.index_usize lanes3 i9
  let i11 ← lift (i10 ^^^ i7)
  let lanes4 ← Array.update lanes3 i9 i11
  let lanes5 ← prehash.keccak_f1600 lanes4
  prehash.shake128_loop2 output lanes5 0#usize 0#usize

/-- [slhdsa::prehash::{slhdsa::prehash::PreHash}::hash_stack]:
    Source: 'src/prehash.rs', lines 81:4-103:5 -/
def prehash.PreHash.hash_stack
  (self : prehash.PreHash) (message : Slice Std.U8) :
  Result ((Array Std.U8 64#usize) × Std.Usize)
  := do
  let out := Array.repeat 64#usize 0#u8
  match self with
  | prehash.PreHash.Sha256 =>
    let d ← sha256.sha256 message
    let (s, index_mut_back) ←
      core.array.Array.index_mut (core.ops.index.IndexMutSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) out
        { «end» := 32#usize }
    let s1 ← lift (Array.to_slice d)
    let s2 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s s1
    let out1 := index_mut_back s2
    ok (out1, 32#usize)
  | prehash.PreHash.Sha512 =>
    let d ← sha512.sha512 message
    let (s, to_slice_mut_back) ← lift (Array.to_slice_mut out)
    let s1 ← lift (Array.to_slice d)
    let s2 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s s1
    let out1 := to_slice_mut_back s2
    ok (out1, 64#usize)
  | prehash.PreHash.Shake128 =>
    let (s, index_mut_back) ←
      core.array.Array.index_mut (core.ops.index.IndexMutSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) out
        { «end» := 32#usize }
    let s1 ← prehash.shake128 message s
    let out1 := index_mut_back s1
    ok (out1, 32#usize)
  | prehash.PreHash.Shake256 =>
    let (s, index_mut_back) ←
      core.array.Array.index_mut (core.ops.index.IndexMutSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) out
        { «end» := 64#usize }
    let s1 ← shake256.shake256 message s
    let out1 := index_mut_back s1
    ok (out1, 64#usize)

/-- [slhdsa::prehash::{slhdsa::prehash::PreHash}::hash]:
    Source: 'src/prehash.rs', lines 73:4-78:5
    Visibility: public -/
def prehash.PreHash.hash
  (self : prehash.PreHash) (message : Slice Std.U8) :
  Result (alloc.vec.Vec Std.U8)
  := do
  let (buf, len) ← prehash.PreHash.hash_stack self message
  let out ← alloc.vec.from_elem core.clone.CloneU8 0#u8 len
  let (s, deref_mut_back) ← lift (alloc.vec.Vec.deref_mut out)
  let s1 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) buf
      { «end» := len }
  let s2 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s s1
  ok (deref_mut_back s2)

/-- [slhdsa::prehash::format_prehash_message]:
    Source: 'src/prehash.rs', lines 241:0-257:1 -/
def prehash.format_prehash_message
  (ctx : Slice Std.U8) (ph : prehash.PreHash) (digest : Slice Std.U8) :
  Result (Option ((Array Std.U8 332#usize) × Std.Usize))
  := do
  let i := Slice.len ctx
  if i > 255#usize
  then ok none
  else
    let i1 := Slice.len digest
    let i2 ← prehash.PreHash.digest_len ph
    if i1 != i2
    then ok none
    else
      let oid ← prehash.PreHash.oid_der ph
      let i3 := Slice.len ctx
      let i4 ← 2#usize + i3
      let s ← lift (Array.to_slice oid)
      let i5 := Slice.len s
      let i6 ← i4 + i5
      let i7 := Slice.len digest
      let total ← i6 + i7
      let mp := Array.repeat 332#usize 0#u8
      let mp1 ← Array.update mp 0#usize 1#u8
      let i8 := Slice.len ctx
      let i9 ← lift (UScalar.cast .U8 i8)
      let mp2 ← Array.update mp1 1#usize i9
      let i10 := Slice.len ctx
      let i11 ← 2#usize + i10
      let (s1, index_mut_back) ←
        core.array.Array.index_mut (core.ops.index.IndexMutSlice
          (core.slice.index.SliceIndexRangeUsizeSlice Std.U8)) mp2
          { start := 2#usize, «end» := i11 }
      let s2 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s1 ctx
      let i12 := Slice.len ctx
      let off ← 2#usize + i12
      let mp3 := index_mut_back s2
      let s3 ← lift (Array.to_slice oid)
      let i13 := Slice.len s3
      let i14 ← off + i13
      let (s4, index_mut_back1) ←
        core.array.Array.index_mut (core.ops.index.IndexMutSlice
          (core.slice.index.SliceIndexRangeUsizeSlice Std.U8)) mp3
          { start := off, «end» := i14 }
      let s5 ← lift (Array.to_slice oid)
      let s6 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s4 s5
      let s7 ← lift (Array.to_slice oid)
      let i15 := Slice.len s7
      let off1 ← off + i15
      let mp4 := index_mut_back1 s6
      let i16 := Slice.len digest
      let i17 ← off1 + i16
      let (s8, index_mut_back2) ←
        core.array.Array.index_mut (core.ops.index.IndexMutSlice
          (core.slice.index.SliceIndexRangeUsizeSlice Std.U8)) mp4
          { start := off1, «end» := i17 }
      let s9 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s8 digest
      let mp5 := index_mut_back2 s9
      ok (some (mp5, total))

/-- [slhdsa::prehash::hash_slh_sign_prehashed]:
    Source: 'src/prehash.rs', lines 267:0-284:1
    Visibility: public -/
def prehash.hash_slh_sign_prehashed
  {N : Std.Usize} (family : cache.HashFamily) (p : params.Params)
  (digest : Slice Std.U8) (ctx : Slice Std.U8) (ph : prehash.PreHash)
  (sk : Slice Std.U8) (addrnd : Array Std.U8 N) :
  Result (Option (alloc.vec.Vec Std.U8))
  := do
  let o ← prehash.format_prehash_message ctx ph digest
  match o with
  | none => ok none
  | some p1 =>
    let (mp, len) := p1
    match family with
    | cache.HashFamily.Sha2 =>
      let s ←
        core.array.Array.index (core.ops.index.IndexSlice
          (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) mp
          { «end» := len }
      let sig ← slh.slh_sign_internal p s sk addrnd
      ok (some sig)
    | cache.HashFamily.Shake =>
      let s ←
        core.array.Array.index (core.ops.index.IndexSlice
          (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) mp
          { «end» := len }
      let sig ← shake.slh.slh_sign_internal p s sk addrnd
      ok (some sig)

/-- [slhdsa::prehash::hash_slh_sign]:
    Source: 'src/prehash.rs', lines 304:0-318:1
    Visibility: public -/
def prehash.hash_slh_sign
  {N : Std.Usize} (family : cache.HashFamily) (p : params.Params)
  (m : Slice Std.U8) (ctx : Slice Std.U8) (ph : prehash.PreHash)
  (sk : Slice Std.U8) (addrnd : Array Std.U8 N) :
  Result (Option (alloc.vec.Vec Std.U8))
  := do
  let i := Slice.len ctx
  if i > 255#usize
  then ok none
  else
    let (digest, dlen) ← prehash.PreHash.hash_stack ph m
    let s ←
      core.array.Array.index (core.ops.index.IndexSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) digest
        { «end» := dlen }
    prehash.hash_slh_sign_prehashed family p s ctx ph sk addrnd

