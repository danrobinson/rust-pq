def prehash.hash_slh_verify_prehashed
  (N : Std.Usize) (family : cache.HashFamily) (p : params.Params)
  (digest : Slice Std.U8) (sig : Slice Std.U8) (ctx : Slice Std.U8)
  (ph : prehash.PreHash) (pk : Slice Std.U8) :
