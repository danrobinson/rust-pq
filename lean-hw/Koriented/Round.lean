private theorem idx {n : Usize} (a : Array U64 n) (i : Usize) (h : i.val < n.val) :
    a.index_usize i = ok a.val[i.val]! := by
  have hi : i.val < a.val.length := by simpa using h
  simp [Array.index_usize, Array.getElem?_Usize_eq, getElem?_pos a.val i.val hi, getElem!_pos a.val i.val hi]

theorem round_plain (a : Array U64 25#usize) (rc : U64) :
    KorientedRust.shake256.oriented.round a rc = ok (plain a rc) := by
  unfold KorientedRust.shake256.oriented.round
  simp (config := {maxSteps := 2000000}) (disch := decide) only [idx, Array.make_val, lift, bind_ok, List.getElem!_cons_zero,
    List.getElem!_cons_succ]
  rfl
end slhdsa.Oriented
