          SM_DT_TCR_Advantage (bTcrArM 2 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 67 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 22 (toInternal (pureBytesToTyped A)))) +
        ((Sha2Set.s256s.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_RealSuccess (rUd pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s256s.vp) pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) :=
  ⟨api_pure_cores, (rust_pure_security_linear optRand pkSeedDist).2⟩

/-! ### 3. The checked signers on well-formed keys -/

/-- **On a well-formed private key the checked hedged signer is the plain one**: `sign_checked` returns exactly what `sign` returns — `ok (some sig)` with the same `sig` for a context of at most 255 bytes, `ok none` for a longer one.  So a signing oracle served by `sign_checked` with a key satisfying `Spec.KeyOk` is the signing oracle served by `sign`. -/
theorem api_sign_checked_eq_sign (m ctx : Slice U8) (sk : Array U8 128#usize)
    (addrnd : Array U8 32#usize) (hm : Room m.length 561) (hk : Spec.KeyOk Spec.sha2_256s (bytes sk.val)) :
    slhdsa.sets.sha2_256s.sign_checked m ctx sk addrnd = slhdsa.sets.sha2_256s.sign m ctx sk addrnd ∧
      (ctx.length ≤ 255 → ∃ sig, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok (some sig)) ∧
      (255 < ctx.length → slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok none) := by
  obtain ⟨r1, h1, e1⟩ := slhdsa.spec_imp_exists (slhdsa.sha2_256s.sign_checked_spec m ctx sk addrnd hm)
  obtain ⟨r2, h2, e2⟩ := slhdsa.sha2_256s.api_sign_correct m ctx sk addrnd hm
  rw [spec_slhSignChecked_eq Spec.sha2_256s Spec.sha2_256s_valid _ _ _ _ hk, ← e2] at e1
  have heq : slhdsa.sets.sha2_256s.sign_checked m ctx sk addrnd = slhdsa.sets.sha2_256s.sign m ctx sk addrnd := by
    rw [h1, h2, optVec_eq e1]
  refine ⟨heq, fun hc => ?_, fun hc => ?_⟩
  · rw [← heq]
    exact slhdsa.sha2_256s.api_sign_checked_complete m ctx sk addrnd hm hc hk
  · rw [slhSign_tooLong Spec.sha2_256s _ ctx _ _ hc, Option.map_eq_none_iff] at e2
    rw [h2, e2]

/-- **On a well-formed private key the checked deterministic signer is the plain one.** -/
theorem api_sign_deterministic_checked_eq (m ctx : Slice U8) (sk : Array U8 128#usize)
    (hm : Room m.length 561) (hk : Spec.KeyOk Spec.sha2_256s (bytes sk.val)) :
    slhdsa.sets.sha2_256s.sign_deterministic_checked m ctx sk = slhdsa.sets.sha2_256s.sign_deterministic m ctx sk ∧
      (ctx.length ≤ 255 → ∃ sig, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok (some sig)) ∧
      (255 < ctx.length → slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok none) := by
  obtain ⟨r1, h1, e1⟩ :=
    slhdsa.spec_imp_exists (slhdsa.sha2_256s.sign_deterministic_checked_spec m ctx sk hm)
  obtain ⟨r2, h2, e2, -⟩ := slhdsa.sha2_256s.api_sign_deterministic_correct m ctx sk hm
  rw [spec_slhSignChecked_eq Spec.sha2_256s Spec.sha2_256s_valid _ _ _ _ hk, ← e2] at e1
  have heq : slhdsa.sets.sha2_256s.sign_deterministic_checked m ctx sk =
      slhdsa.sets.sha2_256s.sign_deterministic m ctx sk := by
    rw [h1, h2, optVec_eq e1]
  refine ⟨heq, fun hc => ?_, fun hc => ?_⟩
  · rw [← heq]
    exact slhdsa.sha2_256s.api_sign_deterministic_checked_complete m ctx sk hm hc hk
  · rw [slhSign_tooLong Spec.sha2_256s _ ctx _ _ hc, Option.map_eq_none_iff] at e2
    rw [h2, e2]

/-- **With a key written by `keygen`, the checked signers are the plain signers**, on every message under the `Room` bound, every context and every `addrnd`. -/
theorem api_keygen_checked_eq (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize)
    (pk0 : Array U8 64#usize) (sk : Array U8 128#usize) (pk : Array U8 64#usize)
    (hkg : slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = ok (sk, pk)) :
    ∀ (m ctx : Slice U8) (addrnd : Array U8 32#usize), Room m.length 561 →
      (slhdsa.sets.sha2_256s.sign_checked m ctx sk addrnd = slhdsa.sets.sha2_256s.sign m ctx sk addrnd ∧
        (ctx.length ≤ 255 → ∃ sig, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok (some sig)) ∧
        (255 < ctx.length → slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok none)) ∧
      (slhdsa.sets.sha2_256s.sign_deterministic_checked m ctx sk = slhdsa.sets.sha2_256s.sign_deterministic m ctx sk ∧
        (ctx.length ≤ 255 → ∃ sig, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok (some sig)) ∧
        (255 < ctx.length → slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok none)) := by
  have hk := (slhdsa.sha2_256s.api_keygen_keyOk seeds sk0 pk0 sk pk hkg).1
  exact fun m ctx addrnd hm =>
    ⟨api_sign_checked_eq_sign m ctx sk addrnd hm hk, api_sign_deterministic_checked_eq m ctx sk hm hk⟩

/-- The same for a key written by `slh_keygen_internal`. -/
theorem keygen_internal_checked_eq (sk_seed sk_prf pk_seed : Array U8 32#usize)
    (sk : Array U8 128#usize) (pk : Array U8 64#usize)
    (hkg : slhdsa.sets.sha2_256s.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk)) :
    ∀ (m ctx : Slice U8) (addrnd : Array U8 32#usize), Room m.length 561 →
      (slhdsa.sets.sha2_256s.sign_checked m ctx sk addrnd = slhdsa.sets.sha2_256s.sign m ctx sk addrnd ∧
        (ctx.length ≤ 255 → ∃ sig, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok (some sig)) ∧
        (255 < ctx.length → slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok none)) ∧
      (slhdsa.sets.sha2_256s.sign_deterministic_checked m ctx sk = slhdsa.sets.sha2_256s.sign_deterministic m ctx sk ∧
        (ctx.length ≤ 255 → ∃ sig, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok (some sig)) ∧
        (255 < ctx.length → slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok none)) := by
  have hk := (slhdsa.sha2_256s.keygen_keyOk sk_seed sk_prf pk_seed sk pk hkg).1
  exact fun m ctx addrnd hm =>
    ⟨api_sign_checked_eq_sign m ctx sk addrnd hm hk, api_sign_deterministic_checked_eq m ctx sk hm hk⟩

/-- **Rust `sign_checked` = `byteSignPure` on well-formed keys.** -/
theorem api_sign_checked_bytes (m ctx : Slice U8) (sk : Array U8 128#usize)
    (addrnd : Array U8 32#usize) (hm : Room m.length 561) (hk : Spec.KeyOk Spec.sha2_256s (bytes sk.val)) :
    ∃ r, slhdsa.sets.sha2_256s.sign_checked m ctx sk addrnd = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
          (node Sha2Set.s256s addrnd) := by
  rw [(api_sign_checked_eq_sign m ctx sk addrnd hm hk).1]
  exact api_sign_bytes m ctx sk addrnd hm

/-- **Rust `sign_deterministic_checked` = `byteSignPure` with `addrnd := PK.seed` on well-formed keys.** -/
theorem api_sign_deterministic_checked_bytes (m ctx : Slice U8) (sk : Array U8 128#usize)
    (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize)
    (hsk : sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val)
    (hm : Room m.length 561) (hk : Spec.KeyOk Spec.sha2_256s (bytes sk.val)) :
    ∃ r, slhdsa.sets.sha2_256s.sign_deterministic_checked m ctx sk = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
          (node Sha2Set.s256s pk_seed) := by
  rw [(api_sign_deterministic_checked_eq m ctx sk hm hk).1]
  exact api_sign_deterministic_bytes m ctx sk sk_seed sk_prf pk_seed pk_root hsk hm

/-- **The signing items of part (a), for the checked signers, on well-formed keys** (in particular every key written by `keygen`, `slhdsa.sha2_256s.api_keygen_keyOk`). -/
theorem api_checked_pure_cores :
    (∀ (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize),
        Room m.length 561 → Spec.KeyOk Spec.sha2_256s (bytes sk.val) →
        ∃ r, slhdsa.sets.sha2_256s.sign_checked m ctx sk addrnd = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s256s addrnd)) ∧
      (∀ (m ctx : Slice U8) (sk : Array U8 128#usize)
          (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize),
        sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val → Room m.length 561 →
        Spec.KeyOk Spec.sha2_256s (bytes sk.val) →
        ∃ r, slhdsa.sets.sha2_256s.sign_deterministic_checked m ctx sk = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s256s pk_seed)) :=
  ⟨api_sign_checked_bytes, api_sign_deterministic_checked_bytes⟩

end ME2E.sha2_256s

