/-! ### 1. The interface functions are the cores of the byte-level scheme -/

/-- `sets::sha2_256s::sign` is `sets::sha2_256s::slh_sign` (both call `slh::slh_sign` on the key slice). -/
theorem api_sign_eq (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize) :
    slhdsa.sets.sha2_256s.sign m ctx sk addrnd = slhdsa.sets.sha2_256s.slh_sign m ctx sk addrnd := by
  unfold slhdsa.sets.sha2_256s.sign slhdsa.sets.sha2_256s.slh_sign slhdsa.api.sign; rfl

/-- `sets::sha2_256s::verify` is `sets::sha2_256s::slh_verify`. -/
theorem api_verify_eq (m sig ctx : Slice U8) (pk : Array U8 64#usize) :
    slhdsa.sets.sha2_256s.verify m sig ctx pk = slhdsa.sets.sha2_256s.slh_verify m sig ctx pk :=
  slhdsa.sha2_256s.verify_eq m sig ctx pk

/-- **`keygen` is `slh_keygen_internal` on the three blocks of `seeds`**: for `seeds = SK.seed ‖ SK.prf ‖ PK.seed`, `keygen seeds sk0 pk0` returns the same pair of arrays as `slh_keygen_internal SK.seed SK.prf PK.seed`, whatever the buffers `sk0`, `pk0` held. -/
theorem api_keygen_eq (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize)
    (pk0 : Array U8 64#usize) (sk_seed sk_prf pk_seed : Array U8 32#usize)
    (hs : seeds.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val) :
    slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = slhdsa.sets.sha2_256s.slh_keygen_internal sk_seed sk_prf pk_seed := by
  obtain ⟨sk', pk', h1, e1⟩ := slhdsa.sha2_256s.api_keygen_correct seeds sk0 pk0
  obtain ⟨sk, pk, h2, e2⟩ := slhdsa.sha2_256s.keygen_correct sk_seed sk_prf pk_seed
  obtain ⟨b0, b1, b2⟩ := block_seeds Spec.sha2_256s (show (32#usize : Usize).val = Spec.sha2_256s.n by rfl) seeds sk_seed sk_prf pk_seed hs
  rw [b0, b1, b2, ← e2, Prod.mk.injEq] at e1
  rw [h1, h2]
  congr 2
  · exact Aeneas.Std.Array.ext _ _ (slhdsa.ht_bytes_injective e1.1)
  · exact Aeneas.Std.Array.ext _ _ (slhdsa.ht_bytes_injective e1.2)

/-- **`sign_deterministic` is `slh_sign` with `addrnd := PK.seed`**: for `sk = SK.seed ‖ SK.prf ‖ PK.seed ‖ PK.root`, `sign_deterministic m ctx sk` returns the same as `slh_sign m ctx sk PK.seed`. -/
theorem api_sign_deterministic_eq (m ctx : Slice U8) (sk : Array U8 128#usize)
    (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize)
    (hsk : sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val)
    (hm : Room m.length 561) :
    slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = slhdsa.sets.sha2_256s.slh_sign m ctx sk pk_seed := by
  obtain ⟨r, h1, e1, -⟩ := slhdsa.sha2_256s.api_sign_deterministic_correct m ctx sk hm
  obtain ⟨r', h2, e2⟩ := slhdsa.sha2_256s.sign_correct m ctx sk pk_seed hm
  rw [block_sk_pkSeed Spec.sha2_256s (show (32#usize : Usize).val = Spec.sha2_256s.n by rfl) sk sk_seed sk_prf pk_seed pk_root hsk, ← e2] at e1
  rw [h1, h2, optVec_eq e1]

/-- **Rust `keygen` = `byteKeygen`** on the three 32-byte blocks of `seeds` (the buffers `sk0`, `pk0` are irrelevant). -/
theorem api_keygen_bytes (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize)
    (pk0 : Array U8 64#usize) (sk_seed sk_prf pk_seed : Array U8 32#usize)
    (hs : seeds.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val) :
    ∃ sk pk, slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = ok (sk, pk) ∧
      (wire pk.val, wire sk.val) =
        byteKeygen Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf) (node Sha2Set.s256s pk_seed) := by
  rw [api_keygen_eq seeds sk0 pk0 sk_seed sk_prf pk_seed hs]
  exact rust_keygen_bytes sk_seed sk_prf pk_seed

/-- **Rust `sign` = `byteSignPure`** (FIPS 205 Alg. 22 with caller-supplied `addrnd`), pointwise. -/
theorem api_sign_bytes (m ctx : Slice U8) (sk : Array U8 128#usize)
    (addrnd : Array U8 32#usize) (hm : Room m.length 561) :
    ∃ r, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
          (node Sha2Set.s256s addrnd) := by
  rw [api_sign_eq]
  exact rust_sign_bytes m ctx sk addrnd hm

/-- **Rust `sign_deterministic` = `byteSignPure` with `addrnd := PK.seed`** (block 2 of the key read as a node; FIPS 205's deterministic variant). -/
theorem api_sign_deterministic_bytes (m ctx : Slice U8) (sk : Array U8 128#usize)
    (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize)
    (hsk : sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val)
    (hm : Room m.length 561) :
    ∃ r, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
          (node Sha2Set.s256s pk_seed) := by
  rw [api_sign_deterministic_eq m ctx sk sk_seed sk_prf pk_seed pk_root hsk hm]
  exact rust_sign_bytes m ctx sk pk_seed hm

/-- **Rust `verify` = `byteVerifyPure`** (FIPS 205 Alg. 24), pointwise. -/
theorem api_verify_bytes (m sig ctx : Slice U8) (pk : Array U8 64#usize)
    (hm : Room m.length 561) :
    slhdsa.sets.sha2_256s.verify m sig ctx pk =
      ok (byteVerifyPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire sig.val) (wire ctx.val)
        (wire pk.val)) := by
  rw [api_verify_eq]
  exact rust_verify_bytes m sig ctx pk hm

/-- **The interface functions are the deterministic cores of the byte-level external pure scheme** `Reduction.pureBytesAlg`: part (a) of `rust_pure_security` for `keygen`, `sign`, `sign_deterministic`, `verify`. -/
theorem api_pure_cores :
    ((∀ (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize) (pk0 : Array U8 64#usize)
          (sk_seed sk_prf pk_seed : Array U8 32#usize),
        seeds.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val →
        ∃ sk pk, slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = ok (sk, pk) ∧
          (wire pk.val, wire sk.val) =
            byteKeygen Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf) (node Sha2Set.s256s pk_seed)) ∧
      (∀ (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize),
        Room m.length 561 →
        ∃ r, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s256s addrnd)) ∧
      (∀ (m ctx : Slice U8) (sk : Array U8 128#usize)
          (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize),
        sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val → Room m.length 561 →
        ∃ r, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s256s pk_seed)) ∧
      (∀ (m sig ctx : Slice U8) (pk : Array U8 64#usize), Room m.length 561 →
        slhdsa.sets.sha2_256s.verify m sig ctx pk =
          ok (byteVerifyPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire sig.val) (wire ctx.val)
            (wire pk.val)))) :=
  ⟨api_keygen_bytes, api_sign_bytes, api_sign_deterministic_bytes, api_verify_bytes⟩

/-- **`PureBytesScheme` for the interface** (as the single-set `E2E/Api.lean`): the fields `keygen_alg`, `sign_alg`, `sign_alg_tooLong`, `verify_alg`, `correct` describe `X = pureBytesAlg …`; `keygen`, `sign`, `sign_deterministic`, `verify` say that the interface functions never panic and are pointwise equal to `byteKeygen`, `byteSignPure` (with `addrnd`, resp. with the `PK.seed` block of the key), `byteVerifyPure`. -/
structure ApiPureBytesEndToEnd (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) : Prop where
  keygen_alg : (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).keygen = do
    let pkSeed ← pkSeedDist
    let skSeed ← $ᵗ Sha2Set.s256s.prims.SkSeed
    let skPrf ← $ᵗ Sha2Set.s256s.prims.SkPrf
    pure (byteKeygen Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) skSeed skPrf pkSeed)
  keygen : ∀ (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize) (pk0 : Array U8 64#usize)
      (sk_seed sk_prf pk_seed : Array U8 32#usize),
    seeds.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val →
    ∃ sk pk, slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = ok (sk, pk) ∧
      (wire pk.val, wire sk.val) =
        byteKeygen Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf) (node Sha2Set.s256s pk_seed)
  sign_alg : ∀ (pk sk m ctx : List SLHDSA.Byte) (k : PublicKeyCore Sha2Set.s256s.prims.core),
    MLink.decodePk Sha2Set.s256s pk = .ok k → ctx.length ≤ 255 →
    (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).sign pk sk (m, ctx) = do
      let addrnd ← optRand k
      pure (byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) m ctx sk addrnd)
  sign_alg_tooLong : ∀ (pk sk m ctx : List SLHDSA.Byte), 255 < ctx.length →
    (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).sign pk sk (m, ctx) = pure none ∧
      ∀ addrnd, byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) m ctx sk addrnd = none
  sign : ∀ (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize),
    Room m.length 561 →
    ∃ r, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val) (node Sha2Set.s256s addrnd)
  sign_deterministic : ∀ (m ctx : Slice U8) (sk : Array U8 128#usize)
      (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize),
    sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val → Room m.length 561 →
    ∃ r, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val) (node Sha2Set.s256s pk_seed)
  verify_alg : ∀ pk m ctx sig : List SLHDSA.Byte,
    (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).verify pk (m, ctx) (some sig) =
        pure (byteVerifyPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) m sig ctx pk) ∧
      (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).verify pk (m, ctx) none = pure false
  verify : ∀ (m sig ctx : Slice U8) (pk : Array U8 64#usize), Room m.length 561 →
    slhdsa.sets.sha2_256s.verify m sig ctx pk =
      ok (byteVerifyPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire sig.val) (wire ctx.val)
        (wire pk.val))
  correct : ∀ m ctx : List SLHDSA.Byte, ctx.length ≤ 255 →
    ProbCompRuntime.probComp.evalDist (do
      let (pk, sk) ← (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).keygen
      let sig ← (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).sign pk sk (m, ctx)
      (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist).verify pk (m, ctx) sig) {true} = 1

/-- `ApiPureBytesEndToEnd` holds for every `opt_rand` source and every `PK.seed` distribution. -/
theorem api_pure_bytes_end_to_end (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) : ApiPureBytesEndToEnd optRand pkSeedDist :=
  have h := pure_bytes_scheme Sha2Set.s256s optRand pkSeedDist
  { keygen_alg := h.keygen_alg
    keygen := api_keygen_bytes
    sign_alg := h.sign_alg
    sign_alg_tooLong := h.sign_alg_tooLong
    sign := api_sign_bytes
    sign_deterministic := api_sign_deterministic_bytes
    verify_alg := h.verify_alg
    verify := api_verify_bytes
    correct := h.correct }

/-! ### Typed forms (`Reduction.externalAlg`) -/

/-- **Rust `slh_keygen_internal` = VCVio's `keygenInternal`** (typed form): the Rust keys are the FIPS encodings of the key pair computed from the seeds read as nodes. -/
theorem rust_keygen (sk_seed sk_prf pk_seed : Array U8 32#usize) :
    ∃ sk pk, slhdsa.sets.sha2_256s.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
      bytes sk.val =
        MLink.skBytes Sha2Set.s256s (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf)
          (node Sha2Set.s256s pk_seed)).2 ∧
      bytes pk.val =
        MLink.pkBytes Sha2Set.s256s (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf)
          (node Sha2Set.s256s pk_seed)).1 := by
  obtain ⟨sk, pk, h, hp⟩ := slhdsa.sha2_256s.keygen_correct sk_seed sk_prf pk_seed
  exact ⟨sk, pk, h, keygen_typed Sha2Set.s256s rfl sk_seed sk_prf pk_seed sk.val pk.val hp⟩

/-- **Rust `slh_sign` = VCVio's `External.signPureWithRandomizer`** (typed form; `secretKey` reads the 128-byte key as a typed key, `skBytes_secretKey`): `none` exactly for VCVio's error value. -/
theorem rust_sign (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize)
    (hm : Room m.length 561) :
    ∃ r, slhdsa.sets.sha2_256s.slh_sign m ctx sk addrnd = ok r ∧
      r.map (fun v => bytes v.val) =
        (External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims (cv (bytes m.val)) (cv (bytes ctx.val))
          (secretKey Sha2Set.s256s sk) (node Sha2Set.s256s addrnd)).toOption.map (MLink.sigBytes Sha2Set.s256s) := by
  obtain ⟨r, h, hp⟩ := slhdsa.sha2_256s.sign_correct m ctx sk addrnd hm
  refine ⟨r, h, ?_⟩
  have e := signPure_typed Sha2Set.s256s rfl rfl m.val ctx.val sk addrnd (r.map fun v => v.val)
    (by rw [Option.map_map]; exact hp)
  rw [Option.map_map] at e
  exact e

/-- **Rust `slh_verify` = VCVio's `External.verifyPure`** on the values of VCVio's strict decoders (typed form). -/
theorem rust_verify (m sig ctx : Slice U8) (pk : Array U8 64#usize)
    (hm : Room m.length 561) :
    slhdsa.sets.sha2_256s.slh_verify m sig ctx pk =
      ok (match MLink.decodeSig Sha2Set.s256s (cv (bytes sig.val)), MLink.decodePk Sha2Set.s256s (cv (bytes pk.val)) with
          | .ok s, .ok k =>
            External.verifyPure Sha2Set.s256s.vp Sha2Set.s256s.prims (cv (bytes m.val)) s (cv (bytes ctx.val)) k
          | _, _ => false) := by
  rw [slhdsa.sha2_256s.verify_correct m sig ctx pk hm, show Spec.sha2_256s = Sha2Set.s256s.spec from rfl,
    verifyPure_typed Sha2Set.s256s m.val sig.val ctx.val pk.val pk.property]
  cases MLink.decodeSig Sha2Set.s256s (cv (bytes sig.val)) <;> cases MLink.decodePk Sha2Set.s256s (cv (bytes pk.val)) <;>
    rfl

/-- **The Rust external API computes the external pure scheme** `X = Reduction.externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist` (typed keys and signatures; as the single-set `E2E/External.lean`). -/
structure PureEndToEnd (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) : Prop where
  keygen_alg : (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).keygen = do
    let pkSeed ← pkSeedDist
    let skSeed ← $ᵗ Sha2Set.s256s.prims.SkSeed
    let skPrf ← $ᵗ Sha2Set.s256s.prims.SkPrf
    pure (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims skSeed skPrf pkSeed)
  keygen : ∀ sk_seed sk_prf pk_seed : Array U8 32#usize,
    ∃ sk pk, slhdsa.sets.sha2_256s.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
      bytes sk.val =
        MLink.skBytes Sha2Set.s256s (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf)
          (node Sha2Set.s256s pk_seed)).2 ∧
      bytes pk.val =
        MLink.pkBytes Sha2Set.s256s (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf)
          (node Sha2Set.s256s pk_seed)).1
  sign_alg : ∀ pk sk (message context : List SLHDSA.Byte), context.length ≤ 255 →
    (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).sign pk sk (message, context) =
      (do let addrnd ← optRand pk
          pure (External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims message context sk addrnd))
  sign_alg_tooLong : ∀ pk sk (message context : List SLHDSA.Byte), 255 < context.length →
    (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).sign pk sk (message, context) =
        pure (.error (.contextTooLong context.length)) ∧
      ∀ addrnd, External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims message context sk addrnd =
        .error (.contextTooLong context.length)
  sign : ∀ (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize),
    Room m.length 561 →
    ∃ r, slhdsa.sets.sha2_256s.slh_sign m ctx sk addrnd = ok r ∧
      r.map (fun v => bytes v.val) =
        (External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims (cv (bytes m.val)) (cv (bytes ctx.val))
          (secretKey Sha2Set.s256s sk) (node Sha2Set.s256s addrnd)).toOption.map (MLink.sigBytes Sha2Set.s256s)
  verify : ∀ (m sig ctx : Slice U8) (pk : Array U8 64#usize), Room m.length 561 →
    ∃ b, slhdsa.sets.sha2_256s.slh_verify m sig ctx pk = ok b ∧
      match MLink.decodeSig Sha2Set.s256s (cv (bytes sig.val)), MLink.decodePk Sha2Set.s256s (cv (bytes pk.val)) with
      | .ok s, .ok k =>
        (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).verify k
          (cv (bytes m.val), cv (bytes ctx.val)) (.ok s) = pure b
      | _, _ => b = false
  correct : ∀ (message context : List SLHDSA.Byte), context.length ≤ 255 →
    ∀ (skSeed : Sha2Set.s256s.prims.SkSeed) (skPrf : Sha2Set.s256s.prims.SkPrf) (pkSeed : Sha2Set.s256s.prims.PkSeed) (addrnd : Sha2Set.s256s.prims.Y),
    ∃ σ, External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims message context
        (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims skSeed skPrf pkSeed).2 addrnd = .ok σ ∧
      (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).verify
        (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims skSeed skPrf pkSeed).1 (message, context) (.ok σ) =
          pure true

/-- `PureEndToEnd` holds for every `opt_rand` source and every `PK.seed` distribution. -/
theorem pure_end_to_end (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) : PureEndToEnd optRand pkSeedDist where
  keygen_alg := rfl
  keygen := rust_keygen
  sign_alg := fun pk sk message context h =>
    Reduction.externalAlg_sign Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist pk sk message context h
  sign_alg_tooLong := fun pk sk message context h =>
    Reduction.externalAlg_sign_tooLong Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist pk sk message context h
  sign := rust_sign
  verify := fun m sig ctx pk hm => by
    refine ⟨_, rust_verify m sig ctx pk hm, ?_⟩
    split
    · rename_i s k hs hk
      exact Reduction.externalAlg_verify_ok Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist k _ _ s
    · simp_all
  correct := fun message context hc skSeed skPrf pkSeed addrnd =>
    Reduction.externalAlg_correct Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist message context hc skSeed
      skPrf pkSeed addrnd

/-- **`PureEndToEnd` for the interface**: `keygen` (on the three blocks of `seeds`), `sign`, `sign_deterministic` (randomness: the `PK.seed` block of the key) and `verify` in place of `slh_keygen_internal`, `slh_sign`, `slh_verify`. -/
structure ApiPureEndToEnd (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) : Prop where
  keygen_alg : (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).keygen = do
    let pkSeed ← pkSeedDist
    let skSeed ← $ᵗ Sha2Set.s256s.prims.SkSeed
    let skPrf ← $ᵗ Sha2Set.s256s.prims.SkPrf
    pure (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims skSeed skPrf pkSeed)
  keygen : ∀ (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize) (pk0 : Array U8 64#usize)
      (sk_seed sk_prf pk_seed : Array U8 32#usize),
    seeds.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val →
    ∃ sk pk, slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = ok (sk, pk) ∧
      bytes sk.val =
        MLink.skBytes Sha2Set.s256s (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf)
          (node Sha2Set.s256s pk_seed)).2 ∧
      bytes pk.val =
        MLink.pkBytes Sha2Set.s256s (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf)
          (node Sha2Set.s256s pk_seed)).1
  sign_alg : ∀ pk sk (message context : List SLHDSA.Byte), context.length ≤ 255 →
    (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).sign pk sk (message, context) =
      (do let addrnd ← optRand pk
          pure (External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims message context sk addrnd))
  sign_alg_tooLong : ∀ pk sk (message context : List SLHDSA.Byte), 255 < context.length →
    (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).sign pk sk (message, context) =
        pure (.error (.contextTooLong context.length)) ∧
      ∀ addrnd, External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims message context sk addrnd =
        .error (.contextTooLong context.length)
  sign : ∀ (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize),
    Room m.length 561 →
    ∃ r, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok r ∧
      r.map (fun v => bytes v.val) =
        (External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims (cv (bytes m.val)) (cv (bytes ctx.val))
          (secretKey Sha2Set.s256s sk) (node Sha2Set.s256s addrnd)).toOption.map (MLink.sigBytes Sha2Set.s256s)
  sign_deterministic : ∀ (m ctx : Slice U8) (sk : Array U8 128#usize)
      (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize),
    sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val → Room m.length 561 →
    ∃ r, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok r ∧
      r.map (fun v => bytes v.val) =
        (External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims (cv (bytes m.val)) (cv (bytes ctx.val))
          (secretKey Sha2Set.s256s sk) (node Sha2Set.s256s pk_seed)).toOption.map (MLink.sigBytes Sha2Set.s256s)
  verify : ∀ (m sig ctx : Slice U8) (pk : Array U8 64#usize), Room m.length 561 →
    ∃ b, slhdsa.sets.sha2_256s.verify m sig ctx pk = ok b ∧
      match MLink.decodeSig Sha2Set.s256s (cv (bytes sig.val)), MLink.decodePk Sha2Set.s256s (cv (bytes pk.val)) with
      | .ok s, .ok k =>
        (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).verify k
          (cv (bytes m.val), cv (bytes ctx.val)) (.ok s) = pure b
      | _, _ => b = false
  correct : ∀ (message context : List SLHDSA.Byte), context.length ≤ 255 →
    ∀ (skSeed : Sha2Set.s256s.prims.SkSeed) (skPrf : Sha2Set.s256s.prims.SkPrf) (pkSeed : Sha2Set.s256s.prims.PkSeed) (addrnd : Sha2Set.s256s.prims.Y),
    ∃ σ, External.signPureWithRandomizer Sha2Set.s256s.vp Sha2Set.s256s.prims message context
        (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims skSeed skPrf pkSeed).2 addrnd = .ok σ ∧
      (externalAlg Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist).verify
        (GeneralScheme.keygenInternal Sha2Set.s256s.vp Sha2Set.s256s.prims skSeed skPrf pkSeed).1 (message, context) (.ok σ) =
          pure true

/-- `ApiPureEndToEnd` holds for every `opt_rand` source and every `PK.seed` distribution. -/
theorem api_pure_end_to_end (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) : ApiPureEndToEnd optRand pkSeedDist :=
  have h := pure_end_to_end optRand pkSeedDist
  { keygen_alg := h.keygen_alg
    keygen := fun seeds sk0 pk0 a b c hs => by
      rw [api_keygen_eq seeds sk0 pk0 a b c hs]
      exact rust_keygen a b c
    sign_alg := h.sign_alg
    sign_alg_tooLong := h.sign_alg_tooLong
    sign := fun m ctx sk addrnd hm => by
      rw [api_sign_eq]
      exact rust_sign m ctx sk addrnd hm
    sign_deterministic := fun m ctx sk a b c d hsk hm => by
      rw [api_sign_deterministic_eq m ctx sk a b c d hsk hm]
      exact rust_sign m ctx sk c hm
    verify := fun m sig ctx pk hm => by
      rw [api_verify_eq]
      exact h.verify m sig ctx pk hm
    correct := h.correct }

/-! ### 2. Headline forms for the interface -/

/-- **The Rust interface (`sets::sha2_256s::{keygen, sign, sign_deterministic, verify}`) and the standard-model security of the scheme it computes (SLH-DSA-SHA2-256s, external pure interface, FIPS 205 Alg. 21/22/24).**

`rust_pure_security` with part (a) about the interface functions: `keygen` (on the three 32-byte blocks `SK.seed ‖ SK.prf ‖ PK.seed` of its 96-byte argument), `sign`, `sign_deterministic` (with `addrnd` the `PK.seed` block of the key) and `verify` never panic and are pointwise equal to `byteKeygen`, `byteSignPure`, `byteVerifyPure` under `Room m.length 561`.  Parts (b), (c) are those of `rust_pure_security`, unchanged, and so is the list (i)–(vi) of what lies between the scheme and the Rust code, with these additions: (i) `keygen` takes the three seeds as one 96-byte string (the caller samples it); a signing oracle served by `sign_deterministic` is the scheme at `optRand pk = pure pk.pkSeed` (`rust_pure_security_deterministic` for the uniform-`PK.seed` bound), using the `PK.seed` held in the *secret* key, which in the games is the one in the public key. -/
theorem api_pure_security (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed) :
    ((∀ (seeds : Array U8 96#usize) (sk0 : Array U8 128#usize) (pk0 : Array U8 64#usize)
          (sk_seed sk_prf pk_seed : Array U8 32#usize),
        seeds.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val →
        ∃ sk pk, slhdsa.sets.sha2_256s.keygen seeds sk0 pk0 = ok (sk, pk) ∧
          (wire pk.val, wire sk.val) =
            byteKeygen Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (node Sha2Set.s256s sk_seed) (node Sha2Set.s256s sk_prf) (node Sha2Set.s256s pk_seed)) ∧
      (∀ (m ctx : Slice U8) (sk : Array U8 128#usize) (addrnd : Array U8 32#usize),
        Room m.length 561 →
        ∃ r, slhdsa.sets.sha2_256s.sign m ctx sk addrnd = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s256s addrnd)) ∧
      (∀ (m ctx : Slice U8) (sk : Array U8 128#usize)
          (sk_seed sk_prf pk_seed pk_root : Array U8 32#usize),
        sk.val = sk_seed.val ++ sk_prf.val ++ pk_seed.val ++ pk_root.val → Room m.length 561 →
        ∃ r, slhdsa.sets.sha2_256s.sign_deterministic m ctx sk = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s256s pk_seed)) ∧
      (∀ (m sig ctx : Slice U8) (pk : Array U8 64#usize), Room m.length 561 →
        slhdsa.sets.sha2_256s.verify m sig ctx pk =
          ok (byteVerifyPure Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) (wire m.val) (wire sig.val) (wire ctx.val)
            (wire pk.val)))) ∧
    (∀ F : SignatureAlg.StrongUnforgeableAdversary
        (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist),
      SignatureAlg.strongUnforgeableAdvantage ProbCompRuntime.probComp F ≤
        (Reduction.skPrfC Sha2Set.s256s.vp Sha2Set.s256s.prims).prfAdvantage (bPrfWC sufCheck (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
        (Reduction.msgPrf Sha2Set.s256s.vp Sha2Set.s256s.prims).prfAdvantage (bPrfMsgWL sufCheck (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
        KeyedHash.ITSRAdvantage (bItsrL (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
        (SM_DT_DSPR_SourceFinalValidity.advantage (toDspr (bOpenPreS (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (toInternal (pureBytesToTyped F.toUnforgeableAdversary))))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
          SM_DT_TCR_Advantage (bTcrArM 2 (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
          SM_DT_TCR_Advantage (bTcrArM 67 (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
          SM_DT_TCR_Advantage (bTcrArM 22 (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
        ((Sha2Set.s256s.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_Advantage (rUd pkSeedDist (bWotsS (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s256s.vp) pkSeedDist (bWotsS (toInternal (pureBytesToTyped F.toUnforgeableAdversary))))) ∧
    ∀ A : SignatureAlg.UnforgeableAdversary
        (pureBytesAlg Sha2Set.s256s.vp Sha2Set.s256s.prims (codec Sha2Set.s256s) optRand pkSeedDist),
      SignatureAlg.unforgeableAdvantage ProbCompRuntime.probComp A ≤
        (Reduction.skPrfC Sha2Set.s256s.vp Sha2Set.s256s.prims).prfAdvantage (bPrfC (toInternal (pureBytesToTyped A))) +
        (Reduction.msgPrf Sha2Set.s256s.vp Sha2Set.s256s.prims).prfAdvantage (bPrfMsgL (toInternal (pureBytesToTyped A))) +
        KeyedHash.ITSRAdvantage (bItsrL (toInternal (pureBytesToTyped A))) +
        (SM_DT_DSPR_SourceFinalValidity.advantage (toDspr (bOpenPreS (toInternal (pureBytesToTyped A)))) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (toInternal (pureBytesToTyped A))))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 2 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 67 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 22 (toInternal (pureBytesToTyped A)))) +
        ((Sha2Set.s256s.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_Advantage (rUd pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s256s.vp) pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) :=
  ⟨api_pure_cores, (rust_pure_security optRand pkSeedDist).2⟩

