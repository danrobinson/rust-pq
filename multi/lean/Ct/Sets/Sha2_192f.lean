  ct_steps

theorem keygen_trace (seeds seeds' : Std.Array U8 72#usize) (sk sk' : Std.Array U8 96#usize)
    (pk pk' : Std.Array U8 48#usize) :
    ∃ r r' t, slhdsa.sets.sha2_192f.keygen seeds sk pk = .ok r ∧
      slhdsa.sets.sha2_192f.keygen seeds' sk' pk' = .ok r' ∧
      (slhdsa_leak.sets.sha2_192f.keygen seeds sk pk).run = .ok (r, t) ∧
      (slhdsa_leak.sets.sha2_192f.keygen seeds' sk' pk').run = .ok (r', t) := by
  obtain ⟨r, h, -⟩ := slhdsa.spec_imp_exists (slhdsa.sha2_192f.keygen_spec seeds sk pk)
  obtain ⟨r', h', -⟩ := slhdsa.spec_imp_exists (slhdsa.sha2_192f.keygen_spec seeds' sk' pk')
  obtain ⟨t, h1, h2, -⟩ := (keygen_ct seeds seeds' sk sk' pk pk').same_trace
    ((slhdsa_leak.sets.sha2_192f.keygen.erase_eq _ _ _).trans h)
    ((slhdsa_leak.sets.sha2_192f.keygen.erase_eq _ _ _).trans h')
  exact ⟨r, r', t, h, h', h1, h2⟩

