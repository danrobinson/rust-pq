namespace Ct.Theorems.sha2_192f

theorem params_eq : slhdsa_leak.sets.sha2_192f.params.PARAMS = slhdsa.sets.sha2_192f.params.PARAMS :=
  slhdsa_leak.sets.sha2_192f.params.PARAMS.erase_eq

/-- What `pk = public_key sk` says about the bytes. -/
theorem pk_val {sk : Std.Array U8 96#usize} {pk : Std.Array U8 48#usize}
    (h : slhdsa.sets.sha2_192f.public_key sk = .ok pk) :
    pk.to_slice.val = sk.to_slice.val.drop (2 * (24#usize : Usize).val) := by
  obtain ⟨v, hv, hp⟩ := slhdsa.spec_imp_exists (slhdsa.sha2_192f.public_key_spec sk)
  rw [hv] at h
  simp only [Result.ok.injEq] at h
  subst h
  apply slhdsa.ht_bytes_injective
  simp only [Std.Array.val_to_slice]
  rw [hp]
  simp [Spec.skPk, Spec.sha2_192f, slhdsa.bytes, List.map_drop]

theorem sk_len (sk : Std.Array U8 96#usize) : sk.to_slice.length = 4 * (24#usize : Usize).val := by
  simp

theorem skOf_len (sk : Std.Array U8 96#usize) (pk : Std.Array U8 48#usize) :
    (slhdsa_leak.Sim.skOf pk.to_slice).length = sk.to_slice.length := by
  have hmax := sk.to_slice.property
  rw [Ct.Sign.skOf_length (by simp at hmax ⊢; omega)]; simp

theorem room (m : Slice U8) (hm : slhdsa.Room m.length 561) :
    slhdsa.Room m.length (slhdsa.msgSlack (24#usize : Usize).val + 257) := by
  rw [slhdsa.sha2_192f.slack]; exact hm

theorem room_internal (m : Slice U8) (hm : slhdsa.Room m.length 304) :
    slhdsa.Room m.length (slhdsa.msgSlack (24#usize : Usize).val) := by
