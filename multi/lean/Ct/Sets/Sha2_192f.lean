/-- PKCS#8 decoding: on inputs of equal length whose first 20 bytes agree, the same trace,
whatever the remaining bytes and the previous buffer contents. -/
theorem pkcs8_decode_ct (der der' : Slice U8) (sk sk' : Std.Array U8 96#usize)
    (h : der.length = der'.length) (hp : der.val.take 20 = der'.val.take 20) :
    Rel (slhdsa_leak.sets.sha2_192f.pkcs8_decode der sk)
      (slhdsa_leak.sets.sha2_192f.pkcs8_decode der' sk') (fun _ _ => True) := by
  unfold slhdsa_leak.sets.sha2_192f.pkcs8_decode
  ct_steps
  all_goals first | ct_side | skip
  simp only [Leak.erase_pure, Result.ok.injEq] at *
  subst_vars
  intro j hj
  exact Ct.Encoding.getElem!_of_take_eq hp j (by simpa using hj)

/-- SPKI decoding: on inputs of equal length whose first 18 bytes agree, the same trace,
whatever the remaining bytes. -/
theorem spki_decode_ct (der der' : Slice U8) (h : der.length = der'.length)
    (hp : der.val.take 18 = der'.val.take 18) :
    Rel (slhdsa_leak.sets.sha2_192f.spki_decode der) (slhdsa_leak.sets.sha2_192f.spki_decode der')
      (fun _ _ => True) := by
  unfold slhdsa_leak.sets.sha2_192f.spki_decode
  ct_steps
  all_goals first | ct_side | skip
  simp only [Leak.erase_pure, Result.ok.injEq] at *
  subst_vars
  intro j hj
  exact Ct.Encoding.getElem!_of_take_eq hp j (by simpa using hj)

/-- And they return: comparing keys returns whether they are equal, with one trace for all
pairs of keys. -/
theorem secret_keys_equal_trace (a b a' b' : Std.Array U8 96#usize) :
    ∃ t, (slhdsa_leak.sets.sha2_192f.secret_keys_equal a b).run = .ok (decide (a = b), t) ∧
      (slhdsa_leak.sets.sha2_192f.secret_keys_equal a' b').run = .ok (decide (a' = b'), t) := by
  obtain ⟨t, h1, h2, -⟩ := (secret_keys_equal_ct a b a' b').same_trace
    ((slhdsa_leak.sets.sha2_192f.secret_keys_equal.erase_eq _ _).trans
      (slhdsa.sha2_192f.secret_keys_equal_correct a b))
    ((slhdsa_leak.sets.sha2_192f.secret_keys_equal.erase_eq _ _).trans
      (slhdsa.sha2_192f.secret_keys_equal_correct a' b'))
  exact ⟨t, h1, h2⟩

/-- PKCS#8 decoding returns the verified results, with one trace for all inputs of a given
length and first 20 bytes. -/
theorem pkcs8_decode_trace (der der' : Slice U8) (sk sk' : Std.Array U8 96#usize)
    (h : der.length = der'.length) (hp : der.val.take 20 = der'.val.take 20) :
    ∃ r r' t, slhdsa.sets.sha2_192f.pkcs8_decode der sk = .ok r ∧
      slhdsa.sets.sha2_192f.pkcs8_decode der' sk' = .ok r' ∧
      (slhdsa_leak.sets.sha2_192f.pkcs8_decode der sk).run = .ok (r, t) ∧
      (slhdsa_leak.sets.sha2_192f.pkcs8_decode der' sk').run = .ok (r', t) := by
  obtain ⟨r, hr, -⟩ := slhdsa.sha2_192f.pkcs8_decode_correct der sk
  obtain ⟨r', hr', -⟩ := slhdsa.sha2_192f.pkcs8_decode_correct der' sk'
  obtain ⟨t, h1, h2, -⟩ := (pkcs8_decode_ct der der' sk sk' h hp).same_trace
    ((slhdsa_leak.sets.sha2_192f.pkcs8_decode.erase_eq _ _).trans hr)
    ((slhdsa_leak.sets.sha2_192f.pkcs8_decode.erase_eq _ _).trans hr')
  exact ⟨r, r', t, hr, hr', h1, h2⟩

/-- SPKI decoding: the same, with 18 bytes. -/
theorem spki_decode_trace (der der' : Slice U8) (h : der.length = der'.length)
    (hp : der.val.take 18 = der'.val.take 18) :
    ∃ r r' t, slhdsa.sets.sha2_192f.spki_decode der = .ok r ∧
      slhdsa.sets.sha2_192f.spki_decode der' = .ok r' ∧
      (slhdsa_leak.sets.sha2_192f.spki_decode der).run = .ok (r, t) ∧
      (slhdsa_leak.sets.sha2_192f.spki_decode der').run = .ok (r', t) := by
  obtain ⟨r, hr, -⟩ := slhdsa.sha2_192f.spki_decode_correct der
  obtain ⟨r', hr', -⟩ := slhdsa.sha2_192f.spki_decode_correct der'
  obtain ⟨t, h1, h2, -⟩ := (spki_decode_ct der der' h hp).same_trace
    ((slhdsa_leak.sets.sha2_192f.spki_decode.erase_eq _).trans hr)
    ((slhdsa_leak.sets.sha2_192f.spki_decode.erase_eq _).trans hr')
  exact ⟨r, r', t, hr, hr', h1, h2⟩

end Ct.Theorems.sha2_192f

