/-- Any two runs of `slh_keygen_internal` that return have the same trace, with no hypothesis
relating the seeds. -/
theorem keygen_internal_ct (sk_seed sk_prf pk_seed sk_seed' sk_prf' pk_seed' : Std.Array U8 24#usize) :
    Rel (slhdsa_leak.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed)
      (slhdsa_leak.sets.sha2_192f.slh_keygen_internal sk_seed' sk_prf' pk_seed') (fun _ _ => True) := by
  unfold slhdsa_leak.sets.sha2_192f.slh_keygen_internal
  ct_steps

/-- And they return: the verified keys, with one and the same trace. -/
theorem keygen_internal_trace (sk_seed sk_prf pk_seed sk_seed' sk_prf' pk_seed' : Std.Array U8 24#usize) :
    ∃ r r' t, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = .ok r ∧
      slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed' sk_prf' pk_seed' = .ok r' ∧
      (slhdsa_leak.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed).run = .ok (r, t) ∧
      (slhdsa_leak.sets.sha2_192f.slh_keygen_internal sk_seed' sk_prf' pk_seed').run = .ok (r', t) := by
  obtain ⟨r, h, -⟩ := slhdsa.spec_imp_exists
    (slhdsa.sha2_192f.slh_keygen_internal_spec sk_seed sk_prf pk_seed)
  obtain ⟨r', h', -⟩ := slhdsa.spec_imp_exists
    (slhdsa.sha2_192f.slh_keygen_internal_spec sk_seed' sk_prf' pk_seed')
  obtain ⟨t, h1, h2, -⟩ := (keygen_internal_ct sk_seed sk_prf pk_seed sk_seed' sk_prf' pk_seed').same_trace
    ((slhdsa_leak.sets.sha2_192f.slh_keygen_internal.erase_eq _ _ _).trans h)
    ((slhdsa_leak.sets.sha2_192f.slh_keygen_internal.erase_eq _ _ _).trans h')
  exact ⟨_, _, t, h, h', h1, h2⟩

