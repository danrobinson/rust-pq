/-- The early exit (context longer than 255 bytes): `slh_sign`, `slh_sign_checked`, `sign`,
`sign_checked` emit only the outcome of the length test; the deterministic signers' trace is
their simulator's (on any signature argument). -/
theorem sign_long_context (m ctx : Slice U8) (sk : Std.Array U8 96#usize)
    (addrnd : Std.Array U8 24#usize) (pk : Std.Array U8 48#usize) (s : Slice U8)
    (hc : 255 < ctx.length) :
    (slhdsa_leak.sets.sha2_192f.slh_sign m ctx sk addrnd).run = .ok (none, [.branch true]) ∧
    (slhdsa_leak.sets.sha2_192f.slh_sign_checked m ctx sk addrnd).run = .ok (none, [.branch true]) ∧
    (∀ t, (slhdsa_leak.sets.sha2_192f.sign m ctx sk addrnd).run = .ok (none, t) ↔ t = [.branch true]) ∧
    (∀ t, (slhdsa_leak.sets.sha2_192f.sign_checked m ctx sk addrnd).run = .ok (none, t) ↔
      t = [.branch true]) ∧
    (∃ t, (slhdsa_leak.sets.sha2_192f.sign_deterministic m ctx sk).run = .ok (none, t) ∧
      (slhdsa_leak.Sim.sha2_192f.signDeterministic pk m ctx s).run = .ok ((), t)) ∧
    (∃ t, (slhdsa_leak.sets.sha2_192f.sign_deterministic_checked m ctx sk).run = .ok (none, t) ∧
      (slhdsa_leak.Sim.sha2_192f.signDeterministicChecked pk m ctx s).run = .ok ((), t)) := by
  unfold slhdsa_leak.sets.sha2_192f.slh_sign slhdsa_leak.sets.sha2_192f.slh_sign_checked
    slhdsa_leak.sets.sha2_192f.sign slhdsa_leak.sets.sha2_192f.sign_checked
    slhdsa_leak.sets.sha2_192f.sign_deterministic slhdsa_leak.sets.sha2_192f.sign_deterministic_checked
  simp only [Leak.pure_bind, params_eq]
  exact ⟨(Ct.Sign.slh_sign_long_ctx _ m ctx _ addrnd hc).1,
    (Ct.Sign.slh_sign_long_ctx _ m ctx _ addrnd hc).2,
    Ct.Sign.api_long_ctx _ slhdsa.sha2_192f.pn m ctx _ (sk_len sk) addrnd _ (skOf_len sk pk) s hc⟩

/-- A consequence in two-run form: two signing runs with keys of the same public key that
return the same signature (for the same message and context) have the same trace, whatever the
secret seeds and the randomness. -/
theorem sign_two_runs (m ctx : Slice U8) (sk sk' : Std.Array U8 96#usize)
    (addrnd addrnd' : Std.Array U8 24#usize) (pk : Std.Array U8 48#usize)
    (hpk : slhdsa.sets.sha2_192f.public_key sk = .ok pk)
    (hpk' : slhdsa.sets.sha2_192f.public_key sk' = .ok pk)
    (hm : slhdsa.Room m.length 561) (sig : alloc.vec.Vec U8) (t t' : Trace)
    (h : (slhdsa_leak.sets.sha2_192f.sign m ctx sk addrnd).run = .ok (some sig, t))
    (h' : (slhdsa_leak.sets.sha2_192f.sign m ctx sk' addrnd').run = .ok (some sig, t')) : t = t' := by
  have e := sign_simulated m ctx sk addrnd pk hpk hm sig t h
  have e' := sign_simulated m ctx sk' addrnd' pk hpk' hm sig t' h'
  rw [e] at e'
  simp only [Result.ok.injEq, Prod.mk.injEq, true_and] at e'
  exact e'

/-! ## (V) Verification: everything is public -/

theorem verify_ct (m sig ctx : Slice U8) (pk : Std.Array U8 48#usize) :
    Rel (slhdsa_leak.sets.sha2_192f.verify m sig ctx pk) (slhdsa_leak.sets.sha2_192f.verify m sig ctx pk)
      (fun a b => a = b) :=
  (Rel.refl _).mono fun _ _ h => h.1

