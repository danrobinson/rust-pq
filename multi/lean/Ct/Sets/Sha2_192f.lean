    Rel (slhdsa_leak.sets.sha2_192f.secret_keys_equal a b)
      (slhdsa_leak.sets.sha2_192f.secret_keys_equal a' b') (fun _ _ => True) := by
  unfold slhdsa_leak.sets.sha2_192f.secret_keys_equal
  ct_steps

