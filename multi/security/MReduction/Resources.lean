        295147905179352825856 ∧
      (thashArityProblem Sha2Set.s256f.vp Sha2Set.s256f.prims pkSeedDist 1).numTargets =
        10885074419541544174423263) ∧
    ((wotsTcrProblemT Sha2Set.s256f.vp Sha2Set.s256f.prims pkSeedDist).numTargets = 316398554352266229316560 ∧
      (wotsTcrProblem Sha2Set.s256f.vp Sha2Set.s256f.prims pkSeedDist).numTargets = 337491791309083977937664) := by
  refine ⟨?_, thashArityProblemT_cap_256f pkSeedDist, wotsTcrProblemT_cap_256f pkSeedDist⟩
  have h := final_resources_final (structural Sha2Set.s256f) A qs hA
  rw [directCounts_256f, keygenHashes_256f, signHashes_256f, verifyHashes_256f] at h
  exact h

/-- External (pure) interface at SLH-DSA-SHA2-256f: query bound of the internal forger and its
resources as numerals. -/
theorem final_resources_final_external_256f
    (optRand : PublicKeyCore Sha2Set.s256f.prims.core → ProbComp Sha2Set.s256f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256f.prims.PkSeed)
    (A : ExtForger Sha2Set.s256f.vp Sha2Set.s256f.prims optRand pkSeedDist) (qs : ℕ)
    (hq : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    (∀ pk, IsQueryBoundP ((toInternal A).main pk) (fun i => i.isRight = true) qs) ∧
      FinalResourcesFinal (toInternal A) qs (directCounts256f qs)
        (16112 + qs * 327266 + 35043) :=
  ⟨toInternal_queryBound A qs hq,
    (final_resources_final_256f optRand pkSeedDist _ qs (toInternal_queryBound A qs hq)).1⟩

end S256f

