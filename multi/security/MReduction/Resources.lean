    arityTargets Sha2Set.s256s.vp 1 + arityTargets Sha2Set.s256s.vp 2 + arityTargets Sha2Set.s256s.vp Sha2Set.s256s.vp.params.len +
      arityTargets Sha2Set.s256s.vp Sha2Set.s256s.vp.params.k = tcrTargets Sha2Set.s256s.vp := by
  have e : ∀ n, arityTargets Sha2Set.s256s.vp n =
      2 ^ 64 * (22 * (2 ^ 14 * arInd n 1 + (2 ^ 14 - 1) * arInd n 2) + arInd n 22) +
        72340172838076673 * (2 ^ 8 * (67 * (15 * arInd n 1) + arInd n 67) +
          (2 ^ 8 - 1) * arInd n 2) := by
    intro n
    unfold arityTargets
    rw [allXmssTrees_length_256s]
    rfl
  have h1 : arityTargets Sha2Set.s256s.vp 1 = 6667703687548240827313408 := by rw [e]; decide
  have h2 : arityTargets Sha2Set.s256s.vp 2 = 6648704626254912560300031 := by rw [e]; decide
  have h3 : arityTargets Sha2Set.s256s.vp Sha2Set.s256s.vp.params.len = 18519084246547628288 := by
    rw [e]; decide
  have h4 : arityTargets Sha2Set.s256s.vp Sha2Set.s256s.vp.params.k = 18446744073709551616 := by
