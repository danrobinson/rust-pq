/-- Target caps of the four class games (`F`, `H`, `T_len`, `T_k`) at SLH-DSA-SHA2-128s; they add
up to `tcrTargets`. -/
theorem arityTargets_128s :
    arityTargets Sha2Set.s128s.vp 1 = 533756792467910173399552 ∧
    arityTargets Sha2Set.s128s.vp 2 = 528785142244921151848447 ∧
    arityTargets Sha2Set.s128s.vp Sha2Set.s128s.vp.params.len = 9241421688590303744 ∧
    arityTargets Sha2Set.s128s.vp Sha2Set.s128s.vp.params.k = 9223372036854775808 ∧
    arityTargets Sha2Set.s128s.vp 1 + arityTargets Sha2Set.s128s.vp 2 + arityTargets Sha2Set.s128s.vp Sha2Set.s128s.vp.params.len +
      arityTargets Sha2Set.s128s.vp Sha2Set.s128s.vp.params.k = tcrTargets Sha2Set.s128s.vp := by
  have e : ∀ n, arityTargets Sha2Set.s128s.vp n =
      2 ^ 63 * (14 * (2 ^ 12 * arInd n 1 + (2 ^ 12 - 1) * arInd n 2) + arInd n 14) +
        18049651735527937 * (2 ^ 9 * (35 * (15 * arInd n 1) + arInd n 35) +
          (2 ^ 9 - 1) * arInd n 2) := by
    intro n
    unfold arityTargets
    rw [allXmssTrees_length_128s]
    rfl
  have h1 : arityTargets Sha2Set.s128s.vp 1 = 533756792467910173399552 := by rw [e]; decide
  have h2 : arityTargets Sha2Set.s128s.vp 2 = 528785142244921151848447 := by rw [e]; decide
  have h3 : arityTargets Sha2Set.s128s.vp Sha2Set.s128s.vp.params.len = 9241421688590303744 := by
    rw [e]; decide
  have h4 : arityTargets Sha2Set.s128s.vp Sha2Set.s128s.vp.params.k = 9223372036854775808 := by
    rw [e]; decide
  refine ⟨h1, h2, h3, h4, ?_⟩
  rw [h1, h2, h3, h4, tcrTargets_128s_val]

/-- Tight target caps of the four class games at SLH-DSA-SHA2-128s, and the loose cap. -/
theorem thashArityProblemT_cap_128s (pkSeedDist : ProbComp Sha2Set.s128s.prims.PkSeed) :
    (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist 1).numTargets =
        533756792467910173399552 ∧
    (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist 2).numTargets =
        528785142244921151848447 ∧
    (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist Sha2Set.s128s.vp.params.len).numTargets =
        9241421688590303744 ∧
    (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist Sha2Set.s128s.vp.params.k).numTargets =
        9223372036854775808 ∧
    (thashArityProblem Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist 1).numTargets =
        1062560399506556770327551 :=
  ⟨(thashArityProblemT_numTargets 1).trans arityTargets_128s.1,
    (thashArityProblemT_numTargets 2).trans arityTargets_128s.2.1,
    (thashArityProblemT_numTargets Sha2Set.s128s.vp.params.len).trans arityTargets_128s.2.2.1,
    (thashArityProblemT_numTargets Sha2Set.s128s.vp.params.k).trans arityTargets_128s.2.2.2.1,
    (thashArityProblem_numTargets 1).trans tcrTargets_128s_val⟩

/-- Tight and loose target caps of the WOTS chain-step TCR game at SLH-DSA-SHA2-128s. -/
theorem wotsTcrProblemT_cap_128s (pkSeedDist : ProbComp Sha2Set.s128s.prims.PkSeed) :
    (wotsTcrProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist).numTargets = 4851746386509909465600 ∧
    (wotsTcrProblem Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist).numTargets = 5175196145610570096640 :=
  ⟨wotsTcrProblemT_numTargets.trans wotsExecutedSteps_128s,
    wotsTcrProblem_numTargets.trans wotsStepTargets_128s_val⟩

/-- Caps of the FORS-leaf DSPR/TCR games and of the WOTS UD/PRE games at SLH-DSA-SHA2-128s. -/
theorem otherCaps_128s (pkSeedDist : ProbComp Sha2Set.s128s.prims.PkSeed) :
    openPreTargets Sha2Set.s128s.vp = 528905046081400263933952 ∧
    (wotsUdProblem Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist).numTargets = 323449759100660631040 ∧
    (wotsPreProblem Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist).numTargets = 323449759100660631040 :=
  ⟨openPreTargets_128s_val, wotsChainTargets_128s_val, wotsChainTargets_128s_val⟩

/-- The resource counts at SLH-DSA-SHA2-128s. -/
def directCounts128s (qs : ℕ) : Resources2.DirectCounts where
  secretReads := 17920 + qs * 182784
  lazyHashes := 269824 + qs * 2007385
  openings := qs * 14
  forsLeaves := 528905046081400263933952
  wotsChains := 323449759100660631040
  wotsSteps := 4851746386509909465600
  thashTargets := 1062560399506556770327551
  structCells := 529228495840500924564992
  arF := 533756792467910173399552
  arH := 528785142244921151848447
  arLen := 9241421688590303744
  arK := 9223372036854775808
  forsP2 := 269824 + qs * 1950027 + (1 + qs + 14)
  tcrP2 := 269824 + qs * 2007385 + 1062560399506556770327551
  udP2 := qs * 121857 + 525
  preP2 := qs * 121857 + 560
  wtcrP2 := qs * 121857 + 16800

theorem directCounts_128s (qs : ℕ) :
    Resources2.directCounts Sha2Set.s128s.vp qs = directCounts128s qs := by
  have h1 : (wotsInsts Sha2Set.s128s.vp).length * Sha2Set.s128s.vp.params.len = 323449759100660631040 := by
    rw [← Resources.wotsChainTargets_eq, wotsChainTargets_128s_val]
  have h2 : Sha2Set.s128s.vp.params.k = 14 := rfl
  obtain ⟨a1, a2, a3, a4, -⟩ := arityTargets_128s
  unfold Resources2.directCounts directCounts128s
  rw [a1, a2, a3, a4, wotsExecutedSteps_128s, h1, keygenReads_128s,
    signReads_128s, keygenHashes_128s, signHashes_128s,
    openPreTargets_128s_val, tcrTargets_128s_val, h2, forsSignHashes_128s,
    wotsSignHistHashes_128s, wotsWinHashes_128s, wotsPreHashes_128s, wotsTcrHashes_128s]

/-- **Resources of every adversary of the final bound at SLH-DSA-SHA2-128s, as numerals**, with the
target caps of the class games and of the chain-step game. -/
theorem final_resources_final_128s
    (optRand : PublicKeyCore Sha2Set.s128s.prims.core → ProbComp Sha2Set.s128s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s128s.prims.PkSeed)
    (A : Forger Sha2Set.s128s.vp Sha2Set.s128s.prims optRand pkSeedDist) (qs : ℕ)
    (hA : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    FinalResourcesFinal A qs (directCounts128s qs) (269824 + qs * 2007385 + 7857) ∧
    ((thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist 1).numTargets =
        533756792467910173399552 ∧
      (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist 2).numTargets =
        528785142244921151848447 ∧
      (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist Sha2Set.s128s.vp.params.len).numTargets =
        9241421688590303744 ∧
      (thashArityProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist Sha2Set.s128s.vp.params.k).numTargets =
        9223372036854775808 ∧
      (thashArityProblem Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist 1).numTargets =
        1062560399506556770327551) ∧
    ((wotsTcrProblemT Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist).numTargets = 4851746386509909465600 ∧
      (wotsTcrProblem Sha2Set.s128s.vp Sha2Set.s128s.prims pkSeedDist).numTargets = 5175196145610570096640) := by
  refine ⟨?_, thashArityProblemT_cap_128s pkSeedDist, wotsTcrProblemT_cap_128s pkSeedDist⟩
  have h := final_resources_final (structural Sha2Set.s128s) A qs hA
  rw [directCounts_128s, keygenHashes_128s, signHashes_128s, verifyHashes_128s] at h
  exact h

/-- External (pure) interface at SLH-DSA-SHA2-128s: query bound of the internal forger and its
resources as numerals. -/
theorem final_resources_final_external_128s
    (optRand : PublicKeyCore Sha2Set.s128s.prims.core → ProbComp Sha2Set.s128s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s128s.prims.PkSeed)
    (A : ExtForger Sha2Set.s128s.vp Sha2Set.s128s.prims optRand pkSeedDist) (qs : ℕ)
    (hq : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    (∀ pk, IsQueryBoundP ((toInternal A).main pk) (fun i => i.isRight = true) qs) ∧
      FinalResourcesFinal (toInternal A) qs (directCounts128s qs)
        (269824 + qs * 2007385 + 7857) :=
  ⟨toInternal_queryBound A qs hq,
    (final_resources_final_128s optRand pkSeedDist _ qs (toInternal_queryBound A qs hq)).1⟩

end S128s


