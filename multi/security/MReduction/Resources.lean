/-- Target caps of the four class games (`F`, `H`, `T_len`, `T_k`) at SLH-DSA-SHA2-192f; they add
up to `tcrTargets`. -/
theorem arityTargets_192f :
    arityTargets Sha2Set.s192f.vp 1 = 687863275013708857286952 ∧
    arityTargets Sha2Set.s192f.vp 2 = 620991192497358345601023 ∧
    arityTargets Sha2Set.s192f.vp Sha2Set.s192f.vp.params.len = 84327972908386521672 ∧
    arityTargets Sha2Set.s192f.vp Sha2Set.s192f.vp.params.k = 73786976294838206464 ∧
    arityTargets Sha2Set.s192f.vp 1 + arityTargets Sha2Set.s192f.vp 2 + arityTargets Sha2Set.s192f.vp Sha2Set.s192f.vp.params.len +
      arityTargets Sha2Set.s192f.vp Sha2Set.s192f.vp.params.k = tcrTargets Sha2Set.s192f.vp := by
  have e : ∀ n, arityTargets Sha2Set.s192f.vp n =
      2 ^ 66 * (33 * (2 ^ 8 * arInd n 1 + (2 ^ 8 - 1) * arInd n 2) + arInd n 33) +
        10540996613548315209 * (2 ^ 3 * (51 * (15 * arInd n 1) + arInd n 51) +
          (2 ^ 3 - 1) * arInd n 2) := by
    intro n
    unfold arityTargets
    rw [allXmssTrees_length_192f]
    rfl
  have h1 : arityTargets Sha2Set.s192f.vp 1 = 687863275013708857286952 := by rw [e]; decide
  have h2 : arityTargets Sha2Set.s192f.vp 2 = 620991192497358345601023 := by rw [e]; decide
  have h3 : arityTargets Sha2Set.s192f.vp Sha2Set.s192f.vp.params.len = 84327972908386521672 := by
    rw [e]; decide
  have h4 : arityTargets Sha2Set.s192f.vp Sha2Set.s192f.vp.params.k = 73786976294838206464 := by
    rw [e]; decide
  refine ⟨h1, h2, h3, h4, ?_⟩
  rw [h1, h2, h3, h4, tcrTargets_192f_val]

