/-- **Resources of every adversary of the final bound at SLH-DSA-SHA2-256s, as numerals**, with the
target caps of the class games and of the chain-step game. -/
theorem final_resources_final_256s
    (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed)
    (A : Forger Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist) (qs : ℕ)
    (hA : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    FinalResourcesFinal A qs (directCounts256s qs) (257792 + qs * 2791676 + 16887) ∧
    ((thashArityProblemT Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist 1).numTargets =
        6667703687548240827313408 ∧
      (thashArityProblemT Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist 2).numTargets =
        6648704626254912560300031 ∧
      (thashArityProblemT Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist Sha2Set.s256s.vp.params.len).numTargets =
        18519084246547628288 ∧
      (thashArityProblemT Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist Sha2Set.s256s.vp.params.k).numTargets =
        18446744073709551616 ∧
      (thashArityProblem Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist 1).numTargets =
        13316445279631473644793343) ∧
    ((wotsTcrProblemT Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist).numTargets = 18611679667780366429440 ∧
      (wotsTcrProblem Sha2Set.s256s.vp Sha2Set.s256s.prims pkSeedDist).numTargets = 19852458312299057524736) := by
  refine ⟨?_, thashArityProblemT_cap_256s pkSeedDist, wotsTcrProblemT_cap_256s pkSeedDist⟩
  have h := final_resources_final (structural Sha2Set.s256s) A qs hA
  rw [directCounts_256s, keygenHashes_256s, signHashes_256s, verifyHashes_256s] at h
  exact h

/-- External (pure) interface at SLH-DSA-SHA2-256s: query bound of the internal forger and its
resources as numerals. -/
theorem final_resources_final_external_256s
    (optRand : PublicKeyCore Sha2Set.s256s.prims.core → ProbComp Sha2Set.s256s.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s256s.prims.PkSeed)
    (A : ExtForger Sha2Set.s256s.vp Sha2Set.s256s.prims optRand pkSeedDist) (qs : ℕ)
    (hq : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    (∀ pk, IsQueryBoundP ((toInternal A).main pk) (fun i => i.isRight = true) qs) ∧
      FinalResourcesFinal (toInternal A) qs (directCounts256s qs)
        (257792 + qs * 2791676 + 16887) :=
  ⟨toInternal_queryBound A qs hq,
    (final_resources_final_256s optRand pkSeedDist _ qs (toInternal_queryBound A qs hq)).1⟩

