import MReduction.Instances

/-!
# Resources and target caps at the six SHA-2 parameter sets, as numerals

GENERATED by `scratchpad/D/gen_res.py`: for each set the analogue of every `*_128s` numeral lemma of
`security/Reduction` that feeds `Reduction.final_resources_final_128s`, proved the same way
(closed forms, then `decide`/`rfl`/`simp` on closed numerals; no `native_decide`).
Names: `MReduction.<lemma>_<set>` for `Reduction.<lemma>_128s`, `MReduction.directCounts<set>`.
The generic statement (no numerals) is `Reduction.final_resources_final (structural S)`, restated
as `final_resources_final_sha2`.
-/

open OracleComp OracleSpec SLHDSA SLHDSA.Security ENNReal

namespace MReduction

open MLink Reduction TweakableHash

set_option linter.unusedVariables false

/-- **Resources of all adversaries of the final bound, any SHA-2 set** (parameter expressions). -/
theorem final_resources_final_sha2 (S : Sha2Set)
    (optRand : PublicKeyCore S.prims.core → ProbComp S.prims.Y)
    (pkSeedDist : ProbComp S.prims.PkSeed)
    (A : Forger S.vp S.prims optRand pkSeedDist) (qs : ℕ)
    (hA : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    FinalResourcesFinal A qs (Resources2.directCounts S.vp qs)
      (Lazy.keygenHashes S.vp + qs * Lazy.signHashes S.vp +
        (1 + Resources2.verifyHashes S.vp * 2)) :=
  final_resources_final (structural S) A qs hA

/-- External (pure) interface: the internal forger `toInternal A` makes at most `qs` signing
queries and has the resources above. -/
theorem final_resources_final_external_sha2 (S : Sha2Set)
    (optRand : PublicKeyCore S.prims.core → ProbComp S.prims.Y)
    (pkSeedDist : ProbComp S.prims.PkSeed)
    (A : ExtForger S.vp S.prims optRand pkSeedDist) (qs : ℕ)
    (hq : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    (∀ pk, IsQueryBoundP ((toInternal A).main pk) (fun i => i.isRight = true) qs) ∧
      FinalResourcesFinal (toInternal A) qs (Resources2.directCounts S.vp qs)
        (Lazy.keygenHashes S.vp + qs * Lazy.signHashes S.vp +
          (1 + Resources2.verifyHashes S.vp * 2)) :=
  final_resources_final_external (structural S) A qs hq


