/-! ## Resources -/

/-- **Resources of the adversaries of `rust_security`** (SLH-DSA-SHA2-192f): if the byte-level
forger makes at most `qs` signing queries (on every public key), so does the typed forger
`bytesToTyped A`, and the resource bundle `Reduction.FinalResourcesFinal` holds for it with the
numerals of this set (`MReduction.directCounts192f`; table: `status/D.md`,
`MReduction/Resources.lean`; the tight caps of the five re-capped games:
`MReduction.final_resources_final_192f`).  For a strong forger `F` use
`A := F.toUnforgeableAdversary` (the same program;
`(bytesToTypedS F).toUnforgeableAdversary = bytesToTyped F.toUnforgeableAdversary` by `rfl`). -/
theorem rust_security_resources (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed)
    (A : SignatureAlg.UnforgeableAdversary (bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist))
    (qs : ℕ) (hA : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    (∀ pk, IsQueryBoundP ((bytesToTyped A).main pk) (fun i => i.isRight = true) qs) ∧
      Reduction.FinalResourcesFinal (bytesToTyped A) qs (MReduction.directCounts192f qs)
        (6136 + qs * 169105 + 34433) :=
  ⟨Reduction.bytesToTyped_queryBound A qs hA,
    (MReduction.final_resources_final_192f optRand pkSeedDist (bytesToTyped A) qs
      (Reduction.bytesToTyped_queryBound A qs hA)).1⟩

/-- **Resources of the adversaries of `rust_pure_security`** (SLH-DSA-SHA2-192f). -/
theorem rust_pure_security_resources (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed)
    (A : SignatureAlg.UnforgeableAdversary (pureBytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist))
    (qs : ℕ) (hA : ∀ pk, IsQueryBoundP (A.main pk) (fun i => i.isRight = true) qs) :
    (∀ pk, IsQueryBoundP ((toInternal (pureBytesToTyped A)).main pk)
        (fun i => i.isRight = true) qs) ∧
      Reduction.FinalResourcesFinal (toInternal (pureBytesToTyped A)) qs
        (MReduction.directCounts192f qs) (6136 + qs * 169105 + 34433) :=
  ⟨Reduction.toInternal_pureBytesToTyped_queryBound A qs hA,
    (MReduction.final_resources_final_192f optRand pkSeedDist (toInternal (pureBytesToTyped A)) qs
      (Reduction.toInternal_pureBytesToTyped_queryBound A qs hA)).1⟩

