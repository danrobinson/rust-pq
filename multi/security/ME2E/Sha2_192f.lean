/-! ### The Rust functions are the byte-level cores -/

/-- **Rust `sha2_192f::slh_keygen_internal` = `byteKeygen`** (FIPS 205 Alg. 18), pointwise: for
all three 24-byte seeds the Rust function does not panic and returns arrays `(sk, pk)` whose
bytes are the pair `byteKeygen = (pk bytes, sk bytes)` at the seeds read as nodes. -/
theorem rust_keygen_bytes (sk_seed sk_prf pk_seed : Array U8 24#usize) :
    ∃ sk pk, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
      (wire pk.val, wire sk.val) =
        byteKeygen Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (node Sha2Set.s192f sk_seed) (node Sha2Set.s192f sk_prf)
          (node Sha2Set.s192f pk_seed) := by
  obtain ⟨sk, pk, h, hp⟩ := slhdsa.sha2_192f.keygen_correct sk_seed sk_prf pk_seed
  exact ⟨sk, pk, h, keygen_transfer Sha2Set.s192f rfl sk_seed sk_prf pk_seed sk.val pk.val hp⟩

/-- **Rust `sha2_192f::slh_sign_internal` = `byteSign`** (FIPS 205 Alg. 19 with
`opt_rand = addrnd`), pointwise: for every message under the `Room` bound, every 96-byte
secret-key array and every 24-byte `addrnd`, the Rust function does not panic and the bytes of
the vector it returns are `byteSign` of the bytes of the message and of the secret key, and of
`addrnd` read as a node. -/
theorem rust_sign_internal_bytes (m : Slice U8) (sk : Array U8 96#usize)
    (addrnd : Array U8 24#usize) (hm : Room m.length 304) :
    ∃ sig, slhdsa.sets.sha2_192f.slh_sign_internal m sk addrnd = ok sig ∧
      wire sig.val =
        byteSign Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sk.val)
          (node Sha2Set.s192f addrnd) := by
  obtain ⟨sig, h, hp⟩ := slhdsa.sha2_192f.sign_internal_correct m sk addrnd hm
  exact ⟨sig, h, sign_transfer Sha2Set.s192f rfl m.val sk.val sig.val addrnd sk.property hp⟩

/-- The signature returned by the Rust `sha2_192f::slh_sign_internal` has 35664 bytes. -/
theorem rust_sign_internal_length (m : Slice U8) (sk : Array U8 96#usize)
    (addrnd : Array U8 24#usize) (hm : Room m.length 304) :
    ∃ sig, slhdsa.sets.sha2_192f.slh_sign_internal m sk addrnd = ok sig ∧
      sig.val.length = 35664 := by
  obtain ⟨sig, h, hp⟩ := rust_sign_internal_bytes m sk addrnd hm
  refine ⟨sig, h, ?_⟩
  have e := congrArg List.length hp
  rw [wire_length] at e
  exact e.trans (byteSign_length Sha2Set.s192f _ _ _ ((wire_length _).trans sk.property))

/-- **Rust `sha2_192f::slh_verify_internal` = `byteVerify`** (FIPS 205 Alg. 20), pointwise: for
every message slice under the `Room` bound, every slice offered as a signature and every
48-byte public-key array, the Rust function does not panic and returns `byteVerify` of the
bytes of its arguments. -/
theorem rust_verify_internal_bytes (m sig : Slice U8) (pk : Array U8 48#usize)
    (hm : Room m.length 304) :
    slhdsa.sets.sha2_192f.slh_verify_internal m sig pk =
      ok (byteVerify Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val)
        (wire pk.val)) := by
  rw [slhdsa.sha2_192f.verify_internal_correct m sig pk hm]
  exact congrArg ok (verify_transfer Sha2Set.s192f m.val sig.val pk.val pk.property)

/-- **Rust `sha2_192f::slh_sign` = `byteSignPure`** (FIPS 205 Alg. 22 with caller-supplied
`addrnd`), pointwise: the Rust function does not panic; it returns `None` exactly when
`byteSignPure` is `none` (context longer than 255 bytes), and otherwise `Some` of a vector with
the bytes `byteSignPure` returns. -/
theorem rust_sign_bytes (m ctx : Slice U8) (sk : Array U8 96#usize)
    (addrnd : Array U8 24#usize) (hm : Room m.length 561) :
    ∃ r, slhdsa.sets.sha2_192f.slh_sign m ctx sk addrnd = ok r ∧
      r.map (fun v => wire v.val) =
        byteSignPure Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire ctx.val) (wire sk.val)
          (node Sha2Set.s192f addrnd) := by
  obtain ⟨r, h, hp⟩ := slhdsa.sha2_192f.sign_correct m ctx sk addrnd hm
  refine ⟨r, h, ?_⟩
  have e := signPure_transfer Sha2Set.s192f rfl m.val ctx.val sk.val addrnd sk.property
    (r.map fun v => v.val) (by rw [Option.map_map]; exact hp)
  rw [Option.map_map] at e
  exact e

/-- **Rust `sha2_192f::slh_verify` = `byteVerifyPure`** (FIPS 205 Alg. 24), pointwise. -/
theorem rust_verify_bytes (m sig ctx : Slice U8) (pk : Array U8 48#usize)
    (hm : Room m.length 561) :
    slhdsa.sets.sha2_192f.slh_verify m sig ctx pk =
      ok (byteVerifyPure Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val)
        (wire ctx.val) (wire pk.val)) := by
  rw [slhdsa.sha2_192f.verify_correct m sig ctx pk hm]
  exact congrArg ok (verifyPure_transfer Sha2Set.s192f m.val sig.val ctx.val pk.val pk.property)

/-- Numerals of the set: node, key and signature lengths in bytes, `len`, `k`, `w − 2`. -/
theorem numerals :
    Sha2Set.s192f.vp.params.n = 24 ∧ Sha2Set.s192f.vp.params.publicKeyBytes = 48 ∧
      Sha2Set.s192f.vp.params.secretKeyBytes = 96 ∧ Sha2Set.s192f.vp.params.signatureBytes = 35664 ∧
      Sha2Set.s192f.vp.params.len = 51 ∧ Sha2Set.s192f.vp.params.k = 33 ∧ Sha2Set.s192f.vp.params.w - 2 = 14 := by
  decide

/-! ### Summary: the schemes and the Rust functions -/

/-- **The Rust internal functions are the deterministic cores of the byte-level scheme**
`B = Reduction.bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist`: `B` is
"sample, then apply `byteKeygen` / `byteSign` / `byteVerify`", returns `[]` when signing under a
public key that is not 48 bytes, and is perfectly complete (`ME2E.BytesScheme`); and the Rust
`slh_keygen_internal`, `slh_sign_internal`, `slh_verify_internal` never panic and are pointwise
equal to these cores under the `Room` bound. -/
theorem bytes_end_to_end (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed) :
    BytesScheme Sha2Set.s192f optRand pkSeedDist ∧
    (∀ sk_seed sk_prf pk_seed : Array U8 24#usize,
      ∃ sk pk, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
        (wire pk.val, wire sk.val) =
          byteKeygen Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (node Sha2Set.s192f sk_seed)
            (node Sha2Set.s192f sk_prf) (node Sha2Set.s192f pk_seed)) ∧
    (∀ (m : Slice U8) (sk : Array U8 96#usize) (addrnd : Array U8 24#usize),
      Room m.length 304 →
      ∃ sig, slhdsa.sets.sha2_192f.slh_sign_internal m sk addrnd = ok sig ∧
        wire sig.val =
          byteSign Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sk.val)
            (node Sha2Set.s192f addrnd)) ∧
    (∀ (m sig : Slice U8) (pk : Array U8 48#usize), Room m.length 304 →
      slhdsa.sets.sha2_192f.slh_verify_internal m sig pk =
        ok (byteVerify Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val)
          (wire pk.val))) :=
  ⟨bytes_scheme Sha2Set.s192f optRand pkSeedDist, rust_keygen_bytes, rust_sign_internal_bytes,
    rust_verify_internal_bytes⟩

/-- **The Rust public API functions are the deterministic cores of the byte-level external pure
scheme** `X = Reduction.pureBytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist`
(`ME2E.PureBytesScheme`: sample, then apply `byteKeygen` / `byteSignPure` / `byteVerifyPure`;
`none` for a context longer than 255 bytes; complete for contexts of at most 255 bytes); the
Rust `slh_keygen_internal`, `slh_sign`, `slh_verify` never panic and are pointwise equal to these
cores under the `Room` bound (the Rust `Option` of `slh_sign` is the scheme's `Option`). -/
theorem pure_bytes_end_to_end
    (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed) :
    PureBytesScheme Sha2Set.s192f optRand pkSeedDist ∧
    (∀ sk_seed sk_prf pk_seed : Array U8 24#usize,
      ∃ sk pk, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
        (wire pk.val, wire sk.val) =
          byteKeygen Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (node Sha2Set.s192f sk_seed)
            (node Sha2Set.s192f sk_prf) (node Sha2Set.s192f pk_seed)) ∧
    (∀ (m ctx : Slice U8) (sk : Array U8 96#usize) (addrnd : Array U8 24#usize),
      Room m.length 561 →
      ∃ r, slhdsa.sets.sha2_192f.slh_sign m ctx sk addrnd = ok r ∧
        r.map (fun v => wire v.val) =
          byteSignPure Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire ctx.val)
            (wire sk.val) (node Sha2Set.s192f addrnd)) ∧
    (∀ (m sig ctx : Slice U8) (pk : Array U8 48#usize), Room m.length 561 →
      slhdsa.sets.sha2_192f.slh_verify m sig ctx pk =
        ok (byteVerifyPure Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val)
          (wire ctx.val) (wire pk.val))) :=
  ⟨pure_bytes_scheme Sha2Set.s192f optRand pkSeedDist, rust_keygen_bytes, rust_sign_bytes,
    rust_verify_bytes⟩

/-! ## Final statements -/

/-- **The Rust internal functions and the standard-model security of the scheme they compute
(SLH-DSA-SHA2-192f, FIPS 205 Alg. 18–20) — final statement.**

Fix how `opt_rand` and `PK.seed` are sampled (`optRand`, `pkSeedDist`; arbitrary — for a
degenerate `pkSeedDist` the statement is about games with a known seed: still true, but the
assumptions are then implausible; see `rust_security_deterministic` / `_hedged` for uniform
`PK.seed`).  Let `B = Reduction.bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand
pkSeedDist`, the signature scheme on byte strings with

  `B.keygen = do pkSeed ← pkSeedDist; skSeed ← $ᵗ; skPrf ← $ᵗ; pure (byteKeygen skSeed skPrf pkSeed)`,
  `B.sign pk sk m = do addrnd ← optRand (parsed pk); pure (byteSign m sk addrnd)`,
  `B.verify pk m sig = pure (byteVerify m sig pk)`

(`bytes_end_to_end` / `ME2E.bytes_scheme`: fields `keygen_alg`, `sign_alg`, `verify_alg`, and
perfect completeness `correct`).

(a) The Aeneas translations of the Rust `sets::sha2_192f::slh_keygen_internal`,
    `slh_sign_internal`, `slh_verify_internal` never panic and are **pointwise equal** to
    `byteKeygen`, `byteSign`, `byteVerify`, for all inputs under the `Room` length bound.
(b) For **every** strong forger `F` against `B` — it receives the 48 public-key bytes, has a
    signing oracle from message bytes to signature bytes, and wins if it outputs a message and a
    byte string that `byteVerify` accepts and that the oracle never returned for that message —
    the SUF-CMA advantage is at most the sum of twelve standard-model advantages:
    PRF on secret-key addresses, PRF_msg, ITSR, SM-DSPR(F) + 3·SM-TCR(F) at the FORS leaves,
    SM-TCR on `F`, `H`, `T_len`, `T_k` (arities `1`, `2`, `len = 51`, `k = 33`; each game capped
    at the exact number of calls of that function in the key structure), 14·SM-UD(F), SM-PRE(F),
    SM-TCR(F) on the WOTS+ chains (capped at `#inst·len·(w−1)`), each at an explicit adversary
    built from the typed forger `bytesToTypedS F` (one typed signing query per query of `F`).
    At this set (`n = 24`): `PRF` (term 1) and every `F` game (terms 4, 5: FORS-leaf DSPR/TCR; term 6:
    class `1`; terms 10–12: WOTS+ UD/PRE/chain-TCR) are `Trunc_24(SHA-256(PK.seed ‖ 0^40 ‖ ADRSc ‖ ·))`; the
    class games `2` (`H`), `len` (`T_len`), `k` (`T_k`) (terms 7–9) are
    `Trunc_24(SHA-512(PK.seed ‖ 0^104 ‖ ADRSc ‖ ·))`; `PRF_msg` (term 2) is HMAC-SHA-512; ITSR (term 3) is about
    `H_msg` = MGF1-SHA-512 over an inner SHA-512; the collection oracle of every SM game is the whole
    `Thash` (both hash functions) (`MReduction/Audit.lean`).
(c) The same for every chosen-message forger `A` (EUF-CMA: the message was never queried).

Resources of the twelve adversaries: `rust_security_resources`.

**The remaining gap between "the scheme in the game" (`B`) and "the Rust functions"** — each
item checked against the statements of (a) and of `bytes_end_to_end`:

(i) *Sampling.*  `B.keygen` draws `PK.seed ← pkSeedDist` and `SK.seed`, `SK.prf` uniformly;
    `B.sign` draws `opt_rand ← optRand pk`.  The Rust functions take `sk_seed`, `sk_prf`,
    `pk_seed`, `addrnd` as *arguments* (quantified in (a)); no Rust code that samples them is
    covered.  The caller must supply them with the distributions of the game (for the
    deterministic variant: pass `addrnd = pk_seed`).
(ii) *Length bounds.*  The Rust equalities for signing and verification are under
    `Room m.length 304` (`m.length + 304 ≤ usize::MAX` and `< 2^61`); key generation has no
    side condition; `B` is defined on all byte strings.
(iii) *Fixed-length arrays.*  The Rust public key is a `[u8; 48]`, the secret key a
    `[u8; 96]`, the returned signature a `Vec<u8>` of 35664 bytes
    (`rust_sign_internal_length`); `B` takes arbitrary byte strings.  On a public key that is
    not 48 bytes `B.verify` rejects (`Reduction.byteVerify_of_pk_length_ne`) and `B.sign`
    returns `[]` (`ME2E.sign_bad_pk`); on a secret key that is not 96 bytes `byteSign` returns
    `[]` (`Reduction.byteSign_of_sk_length_ne`); `[]` is never accepted
    (`Reduction.byteVerify_nil`); lengths: `numerals`.  Such inputs cannot be passed to the Rust
    functions and do not arise in the games (keys come from `B.keygen`).  Every 48-byte /
    96-byte string parses (`ME2E.decodePk_wire`, `ME2E.decodeSk_wire`): no well-formedness of
    the secret key is checked — `byteSign` and the Rust signer use the `PK.seed`, `PK.root`
    stored in the secret key as they are.  The signature argument of the Rust verifier is a
    slice of any length, as in `B`.
(iv) *Byte representations.*  Rust bytes are Aeneas `U8`, the scheme's bytes Lean `UInt8`,
    identified by `wire = MLink.cv ∘ slhdsa.bytes`, a length-preserving bijection of lists
    (`ME2E.wire_length`, `wire_injective`, `wire_surjective`).  The 24-byte seed and `addrnd`
    arrays are read as `Vector UInt8 24` by `node Sha2Set.s192f` (`ME2E.nd_node`: same bytes),
    which is the carrier of `prims.SkSeed`, `prims.SkPrf`, `prims.PkSeed`, `prims.Y`.
    `byteKeygen` returns `(pk, sk)`, the Rust function `(sk, pk)`.  Every Rust `Result` is `ok`
    (no panic).
(v) *The public key in signing.*  `B.sign pk sk m` parses the public-key argument only to
    evaluate `optRand` on it; `slh_sign_internal` has no public-key argument.  In the games the
    two copies of `PK.seed` (in `pk` and in `sk`) agree, both coming from `byteKeygen`.
(vi) *Outside the statement.*  The twelve advantages on the right are not bounded (they are
    assumptions on the SHA-256- and SHA-512-based functions of FIPS 205 §11.2 at this set); no running-time claim
    (resources are counted in oracle queries, samples and hash evaluations; nine of the twelve
    adversaries walk the whole key structure); single key; the Rust compiler, the Aeneas
    extraction, the per-set instantiation `sets.rs` being the one extracted, and side
    channels. -/
theorem rust_security (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed) :
    ((∀ sk_seed sk_prf pk_seed : Array U8 24#usize,
        ∃ sk pk, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
          (wire pk.val, wire sk.val) =
            byteKeygen Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (node Sha2Set.s192f sk_seed) (node Sha2Set.s192f sk_prf) (node Sha2Set.s192f pk_seed)) ∧
      (∀ (m : Slice U8) (sk : Array U8 96#usize) (addrnd : Array U8 24#usize),
        Room m.length 304 →
        ∃ sig, slhdsa.sets.sha2_192f.slh_sign_internal m sk addrnd = ok sig ∧
          wire sig.val = byteSign Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sk.val) (node Sha2Set.s192f addrnd)) ∧
      (∀ (m sig : Slice U8) (pk : Array U8 48#usize), Room m.length 304 →
        slhdsa.sets.sha2_192f.slh_verify_internal m sig pk =
          ok (byteVerify Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val) (wire pk.val)))) ∧
    (∀ F : SignatureAlg.StrongUnforgeableAdversary
        (bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist),
      SignatureAlg.strongUnforgeableAdvantage ProbCompRuntime.probComp F ≤
        (Reduction.skPrfC Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfWC sufCheck (bytesToTypedS F).toUnforgeableAdversary) +
        (Reduction.msgPrf Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfMsgWL sufCheck (bytesToTypedS F).toUnforgeableAdversary) +
        KeyedHash.ITSRAdvantage (bItsrL (bytesToTypedS F).toUnforgeableAdversary) +
        (SM_DT_DSPR_SourceFinalValidity.advantage (toDspr (bOpenPreS (bytesToTypedS F).toUnforgeableAdversary)) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (bytesToTypedS F).toUnforgeableAdversary))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (bytesToTypedS F).toUnforgeableAdversary) +
          SM_DT_TCR_Advantage (bTcrArM 2 (bytesToTypedS F).toUnforgeableAdversary) +
          SM_DT_TCR_Advantage (bTcrArM 51 (bytesToTypedS F).toUnforgeableAdversary) +
          SM_DT_TCR_Advantage (bTcrArM 33 (bytesToTypedS F).toUnforgeableAdversary)) +
        ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_Advantage (rUd pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary)) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary)) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s192f.vp) pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary))) ∧
    ∀ A : SignatureAlg.UnforgeableAdversary (bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist),
      SignatureAlg.unforgeableAdvantage ProbCompRuntime.probComp A ≤
        (Reduction.skPrfC Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfC (bytesToTyped A)) +
        (Reduction.msgPrf Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfMsgL (bytesToTyped A)) +
        KeyedHash.ITSRAdvantage (bItsrL (bytesToTyped A)) +
        (SM_DT_DSPR_SourceFinalValidity.advantage (toDspr (bOpenPreS (bytesToTyped A))) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (bytesToTyped A)))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (bytesToTyped A)) +
          SM_DT_TCR_Advantage (bTcrArM 2 (bytesToTyped A)) +
          SM_DT_TCR_Advantage (bTcrArM 51 (bytesToTyped A)) +
          SM_DT_TCR_Advantage (bTcrArM 33 (bytesToTyped A))) +
        ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_Advantage (rUd pkSeedDist (bWotsS (bytesToTyped A))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (bytesToTyped A))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s192f.vp) pkSeedDist (bWotsS (bytesToTyped A))) :=
  ⟨⟨rust_keygen_bytes, rust_sign_internal_bytes, rust_verify_internal_bytes⟩,
    fun F => MReduction.slhdsa_sha2_192f_bytes_suf_cma_final optRand pkSeedDist F,
    fun A => MReduction.slhdsa_sha2_192f_bytes_euf_cma_final optRand pkSeedDist A⟩

/-- **The Rust public API and the standard-model security of the scheme it computes
(SLH-DSA-SHA2-192f, external pure interface, FIPS 205 Alg. 21/22/24) — final statement.**

Let `X = Reduction.pureBytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist`:
messages are `(message, context)` pairs of byte strings, a signature is `Option (List UInt8)` —
the return type of the Rust `slh_sign`, `none` for a context longer than 255 bytes — with key
generation as in `rust_security`, `X.sign pk sk (M, ctx) = do addrnd ← optRand (parsed pk);
pure (byteSignPure M ctx sk addrnd)` for `|ctx| ≤ 255` and `pure none` (nothing sampled)
otherwise, `X.verify pk (M, ctx) (some sig) = pure (byteVerifyPure M sig ctx pk)`, `none`
rejected (`pure_bytes_end_to_end` / `ME2E.pure_bytes_scheme`; complete for contexts of at most
255 bytes).

(a) The Rust `sets::sha2_192f::slh_keygen_internal`, `slh_sign`, `slh_verify` never panic and
    are pointwise equal to `byteKeygen`, `byteSignPure`, `byteVerifyPure` under
    `Room m.length 561` (the Rust `Option` of `slh_sign` is the scheme's `Option`).
(b) For every strong forger `F` against `X` — a forgery is `((message, context), some bytes)`
    accepted by `byteVerifyPure` and never returned for that pair; `none` is never accepted —
    the SUF-CMA advantage is at most the twelve advantages of `rust_security` (`len = 51`,
    `k = 33`, same hash functions), at the internal typed forger
    `toInternal (pureBytesToTyped F.toUnforgeableAdversary)` (at most one internal signing query
    per query of `F`; `Reduction.toInternal_pureBytesToTyped_queryBound`).
(c) The same for every chosen-message forger `A` (EUF-CMA).

The gap between `X` and the Rust functions is that of `rust_security`, items (i)–(vi), with
these changes: (ii) the `Room` slack is 561; (iii) `X.sign` returns `none` when the context is
over-long (before sampling; `byteSignPure` is `none` there for every `addrnd`,
`Reduction.byteSignPure_tooLong`) or the public key does not parse, and `byteSignPure` returns
`none` when the secret key is not 96 bytes; contexts are slices on the Rust side and arbitrary
byte strings in `X`.  Pure mode only: the pre-hash interface (`HashSLH-DSA`) and mixed use of
one key in both modes are not covered. -/
theorem rust_pure_security (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed) :
    ((∀ sk_seed sk_prf pk_seed : Array U8 24#usize,
        ∃ sk pk, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
          (wire pk.val, wire sk.val) =
            byteKeygen Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (node Sha2Set.s192f sk_seed) (node Sha2Set.s192f sk_prf) (node Sha2Set.s192f pk_seed)) ∧
      (∀ (m ctx : Slice U8) (sk : Array U8 96#usize) (addrnd : Array U8 24#usize),
        Room m.length 561 →
        ∃ r, slhdsa.sets.sha2_192f.slh_sign m ctx sk addrnd = ok r ∧
          r.map (fun v => wire v.val) =
            byteSignPure Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire ctx.val) (wire sk.val)
              (node Sha2Set.s192f addrnd)) ∧
      (∀ (m sig ctx : Slice U8) (pk : Array U8 48#usize), Room m.length 561 →
        slhdsa.sets.sha2_192f.slh_verify m sig ctx pk =
          ok (byteVerifyPure Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val) (wire ctx.val)
            (wire pk.val)))) ∧
    (∀ F : SignatureAlg.StrongUnforgeableAdversary
        (pureBytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist),
      SignatureAlg.strongUnforgeableAdvantage ProbCompRuntime.probComp F ≤
        (Reduction.skPrfC Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfWC sufCheck (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
        (Reduction.msgPrf Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfMsgWL sufCheck (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
        KeyedHash.ITSRAdvantage (bItsrL (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
        (SM_DT_DSPR_SourceFinalValidity.advantage (toDspr (bOpenPreS (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (toInternal (pureBytesToTyped F.toUnforgeableAdversary))))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
          SM_DT_TCR_Advantage (bTcrArM 2 (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
          SM_DT_TCR_Advantage (bTcrArM 51 (toInternal (pureBytesToTyped F.toUnforgeableAdversary))) +
          SM_DT_TCR_Advantage (bTcrArM 33 (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
        ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_Advantage (rUd pkSeedDist (bWotsS (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (toInternal (pureBytesToTyped F.toUnforgeableAdversary)))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s192f.vp) pkSeedDist (bWotsS (toInternal (pureBytesToTyped F.toUnforgeableAdversary))))) ∧
    ∀ A : SignatureAlg.UnforgeableAdversary
        (pureBytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist),
      SignatureAlg.unforgeableAdvantage ProbCompRuntime.probComp A ≤
        (Reduction.skPrfC Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfC (toInternal (pureBytesToTyped A))) +
        (Reduction.msgPrf Sha2Set.s192f.vp Sha2Set.s192f.prims).prfAdvantage (bPrfMsgL (toInternal (pureBytesToTyped A))) +
        KeyedHash.ITSRAdvantage (bItsrL (toInternal (pureBytesToTyped A))) +
        (SM_DT_DSPR_SourceFinalValidity.advantage (toDspr (bOpenPreS (toInternal (pureBytesToTyped A)))) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (toInternal (pureBytesToTyped A))))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 2 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 51 (toInternal (pureBytesToTyped A))) +
          SM_DT_TCR_Advantage (bTcrArM 33 (toInternal (pureBytesToTyped A)))) +
        ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_Advantage (rUd pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s192f.vp) pkSeedDist (bWotsS (toInternal (pureBytesToTyped A)))) :=
