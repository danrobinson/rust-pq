/-! ## Linear form -/

/-- **`rust_security` in linear (signed-pair) form** (SLH-DSA-SHA2-192f).  Same scheme, same
games, same twelve adversaries; the four distinguishing advantages are replaced by their two
sides:

  `Adv + [Pr_ideal(PRF) + Pr_ideal(PRF_msg) + SPprob(DSPR) + 14·Pr_ideal(UD)]`
  `  ≤ Pr_real(PRF) + Pr_real(PRF_msg) + ITSR + (Succ(DSPR) + 3·TCR) + (four TCR) +`
  `      14·Pr_real(UD) + PRE + TCR`.

`prfRealPr B` / `prfIdealPr B`: probability that the PRF distinguisher `B` outputs `true` with
the real function resp. a lazy random function (`msgRealPr`, `msgIdealPr`: the same for
PRF_msg); `SM_DT_UD_RealSuccess` / `SM_DT_UD_IdealSuccess`: the SM-UD experiment in the real /
ideal world; `SM_DT_DSPR_SourceFinalValidity.Success` / `.SPProbability`: the DSPR experiment
and the second-preimage-existence experiment of the same adversary.  Every term is the
probability of `true` of an explicit experiment (`≤ 1`); there is no absolute value and no
truncated subtraction.  The absolute-value statement `rust_security` follows by cancelling the
finite left bracket (`Reduction.boundFinalTight_of_linear`). -/
theorem rust_security_linear (optRand : PublicKeyCore Sha2Set.s192f.prims.core → ProbComp Sha2Set.s192f.prims.Y)
    (pkSeedDist : ProbComp Sha2Set.s192f.prims.PkSeed) :
    ((∀ sk_seed sk_prf pk_seed : Array U8 24#usize,
        ∃ sk pk, slhdsa.sets.sha2_192f.slh_keygen_internal sk_seed sk_prf pk_seed = ok (sk, pk) ∧
          (wire pk.val, wire sk.val) =
            byteKeygen Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (node Sha2Set.s192f sk_seed) (node Sha2Set.s192f sk_prf) (node Sha2Set.s192f pk_seed)) ∧
      (∀ (m : Slice U8) (sk : Array U8 96#usize) (addrnd : Array U8 24#usize),
        Room m.length 304 →
        ∃ sig, slhdsa.sets.sha2_192f.slh_sign_internal m sk addrnd = ok sig ∧
          wire sig.val = byteSign Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sk.val) (node Sha2Set.s192f addrnd)) ∧
      (∀ (m sig : Slice U8) (pk : Array U8 48#usize), Room m.length 304 →
        slhdsa.sets.sha2_192f.slh_verify_internal m sig pk =
          ok (byteVerify Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) (wire m.val) (wire sig.val) (wire pk.val)))) ∧
    (∀ F : SignatureAlg.StrongUnforgeableAdversary
        (bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist),
      SignatureAlg.strongUnforgeableAdvantage ProbCompRuntime.probComp F +
          (prfIdealPr (bPrfWC sufCheck (bytesToTypedS F).toUnforgeableAdversary) +
            msgIdealPr (bPrfMsgWL sufCheck (bytesToTypedS F).toUnforgeableAdversary) +
            SM_DT_DSPR_SourceFinalValidity.SPProbability (toDspr (bOpenPreS (bytesToTypedS F).toUnforgeableAdversary)) +
            ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
              SM_DT_UD_IdealSuccess (rUd pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary))) ≤
        prfRealPr (bPrfWC sufCheck (bytesToTypedS F).toUnforgeableAdversary) +
        msgRealPr (bPrfMsgWL sufCheck (bytesToTypedS F).toUnforgeableAdversary) +
        KeyedHash.ITSRAdvantage (bItsrL (bytesToTypedS F).toUnforgeableAdversary) +
        (SM_DT_DSPR_SourceFinalValidity.Success (toDspr (bOpenPreS (bytesToTypedS F).toUnforgeableAdversary)) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (bytesToTypedS F).toUnforgeableAdversary))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (bytesToTypedS F).toUnforgeableAdversary) +
          SM_DT_TCR_Advantage (bTcrArM 2 (bytesToTypedS F).toUnforgeableAdversary) +
          SM_DT_TCR_Advantage (bTcrArM 51 (bytesToTypedS F).toUnforgeableAdversary) +
          SM_DT_TCR_Advantage (bTcrArM 33 (bytesToTypedS F).toUnforgeableAdversary)) +
        ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_RealSuccess (rUd pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary)) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary)) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s192f.vp) pkSeedDist (bWotsS (bytesToTypedS F).toUnforgeableAdversary))) ∧
    ∀ A : SignatureAlg.UnforgeableAdversary (bytesAlg Sha2Set.s192f.vp Sha2Set.s192f.prims (codec Sha2Set.s192f) optRand pkSeedDist),
      SignatureAlg.unforgeableAdvantage ProbCompRuntime.probComp A +
          (prfIdealPr (bPrfC (bytesToTyped A)) +
            msgIdealPr (bPrfMsgL (bytesToTyped A)) +
            SM_DT_DSPR_SourceFinalValidity.SPProbability (toDspr (bOpenPreS (bytesToTyped A))) +
            ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
              SM_DT_UD_IdealSuccess (rUd pkSeedDist (bWotsS (bytesToTyped A)))) ≤
        prfRealPr (bPrfC (bytesToTyped A)) +
        msgRealPr (bPrfMsgL (bytesToTyped A)) +
        KeyedHash.ITSRAdvantage (bItsrL (bytesToTyped A)) +
        (SM_DT_DSPR_SourceFinalValidity.Success (toDspr (bOpenPreS (bytesToTyped A))) +
          3 * SM_DT_TCR_SourceFinalValidity.advantage (toTcr (bOpenPreS (bytesToTyped A)))) +
        (SM_DT_TCR_Advantage (bTcrArM 1 (bytesToTyped A)) +
          SM_DT_TCR_Advantage (bTcrArM 2 (bytesToTyped A)) +
          SM_DT_TCR_Advantage (bTcrArM 51 (bytesToTyped A)) +
          SM_DT_TCR_Advantage (bTcrArM 33 (bytesToTyped A))) +
        ((Sha2Set.s192f.vp.params.w - 2 : ℕ) : ℝ≥0∞) *
          SM_DT_UD_RealSuccess (rUd pkSeedDist (bWotsS (bytesToTyped A))) +
        SM_DT_PRE_Advantage (rPre pkSeedDist (bWotsS (bytesToTyped A))) +
        SM_DT_TCR_Advantage (rTcrT (vp := Sha2Set.s192f.vp) pkSeedDist (bWotsS (bytesToTyped A))) :=
  ⟨⟨rust_keygen_bytes, rust_sign_internal_bytes, rust_verify_internal_bytes⟩,
    fun F => MReduction.slhdsa_sha2_192f_bytes_suf_cma_linear optRand pkSeedDist F,
    fun A => MReduction.slhdsa_sha2_192f_bytes_euf_cma_linear optRand pkSeedDist A⟩

