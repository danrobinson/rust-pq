C SigningPhasePublication
{ [slot]=0; [done]=0; [roots]=0; [ready]=0; }

P0(atomic_int *slot, atomic_int *done) {
  atomic_store_explicit(slot, 1, memory_order_relaxed);
  int first = atomic_fetch_add_explicit(done, 1, memory_order_acq_rel);
}
P1(atomic_int *slot, atomic_int *done, atomic_int *roots, atomic_int *ready) {
  int reduced = -1;
  int last = atomic_fetch_add_explicit(done, 1, memory_order_acq_rel);
  if (last == 1) {
    reduced = atomic_load_explicit(slot, memory_order_relaxed);
    atomic_store_explicit(roots, 1, memory_order_relaxed);
    atomic_store_explicit(ready, 1, memory_order_release);
  }
}
P2(atomic_int *roots, atomic_int *ready) {
  int seen = atomic_load_explicit(ready, memory_order_acquire);
  int input = -1;
  if (seen == 1) {
    input = atomic_load_explicit(roots, memory_order_relaxed);
  }
}

exists ((1:last=1 /\ 1:reduced=0) \/ (2:seen=1 /\ 2:input=0))
