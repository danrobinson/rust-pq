C PoolResetPublish
{ [job]=0; [remaining]=0; [slot]=0; [used]=0; }

P0(atomic_int *job, atomic_int *remaining, atomic_int *slot, atomic_int *used) {
  atomic_store_explicit(job, 1, memory_order_relaxed);
  atomic_store_explicit(remaining, 2, memory_order_relaxed);
  int old = atomic_exchange_explicit(slot, 2, memory_order_acq_rel);
  int join = atomic_load_explicit(remaining, memory_order_acquire);
  int done = atomic_load_explicit(used, memory_order_relaxed);
}

P1(atomic_int *job, atomic_int *remaining, atomic_int *slot, atomic_int *used) {
  int value = -1;
  int state = atomic_load_explicit(slot, memory_order_acquire);
  if (state == 2) {
    value = atomic_load_explicit(job, memory_order_relaxed);
    atomic_store_explicit(used, 1, memory_order_relaxed);
    atomic_store_explicit(slot, 0, memory_order_release);
    int old = atomic_fetch_sub_explicit(remaining, 2, memory_order_seq_cst);
  }
}

exists (1:value=0 \/ (0:join=0 /\ 0:done=0))
